# IMAGIS - Consultorio de Imagenología Médica & PACS Cloud
# Archivo de configuración de variables de entorno de ejemplo

# Google Gemini API Key (Requerido para análisis de seguridad y asistente radiológico con IA)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Puerto de ejecución del servidor Express + Vite
PORT=3000

# Entorno de ejecución ('development' o 'production')
NODE_ENV=development
