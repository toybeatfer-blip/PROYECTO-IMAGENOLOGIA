      target_content: "  if (!currentStudy) {\n    return (\n      <div className=\"flex-1 h-full flex items-center justify-center bg-zinc-950 text-zinc-400\">\n        No hay estudios radiol\303\263gicos disponibles.\n      </div>\n    );\n  }\n\n  const activeSeries: MedicalStudySeries =\n    currentStudy.series[activeSeriesIndex] || currentStudy.series[0];\n  const currentSlice = activeSeries.slices[sliceIndex] || activeSeries.slices[0];\n\n  const secondarySeries: MedicalStudySeries =\n    currentStudy.series[secondarySeriesIndex] || currentStudy.series[0];\n  const secondarySlice = secondarySeries.slices[secondarySliceIndex] || secondarySeries.slices[0];\n\n  const handleSelectSeries = (index: number) => {\n    setActiveSeriesIndex(index);\n    setSliceIndex(0);\n  };\n\n  const handleApplyPreset = (preset: ViewerWindowPreset) => {\n    switch (preset) {\n      case \'BONE\':\n        setBrightness(70);\n        setContrast(180);\n        setColormap(\'GRAYSCALE\');\n        break;\n      case \'SOFT_TISSUE\':\n        setBrightness(110);\n        setContrast(120);\n        setColormap(\'GRAYSCALE\');\n        break;\n      case \'LUNG\':\n        setBrightness(85);\n        setContrast(160);\n        setColormap(\'GRAYSCALE\');\n        break;\n      case \'BRAIN\':\n        setBrightness(100);\n        setContrast(115);\n        setColormap(\'GRAYSCALE\');\n        break;\n      case \'INVERTED\':\n        setColormap(\'INVERTED\');\n        break;\n      default:\n        setBrightness(100);\n        setContrast(100);\n        setColormap(\'GRAYSCALE\');\n        break;\n    }\n  };\n\n  const handleResetView = () => {\n    setZoom(1.0);\n    setPan({ x: 0, y: 0 });\n    setBrightness(100);\n    setContrast(100);\n    setColormap(\'GRAYSCALE\');\n  };\n\n  const handleAddAnnotation = (newAnn: SliceAnnotation) => {\n    setAnnotations(prev => [...prev, newAnn]);\n  };\n\n  const handleDeleteAnnotation = (id: string) => {\n    setAnnotations(prev => prev.filter(a => a.id !== id));\n  };\n\n  return (\n    <div className=\"flex-1 flex flex-col h-full bg-zinc-950 text-zinc-100 overflow-hidden select-none\">\n      {/* Top Study Switcher & Header Bar */}\n      <div className=\"bg-zinc-950 border-b border-zinc-800 px-4 py-2 flex flex-wrap items-center justify-between gap-3\">\n        <div className=\"flex items-center gap-3\">\n          {onBackToDirectory && (\n            <button\n              onClick={onBackToDirectory}\n              className=\"flex items-center gap-1.5 px-2.5 py-1.5 bg-zinc-900 hover:bg-zinc-800 text-zinc-300 text-xs font-medium rounded-md border border-zinc-800 transition-colors\"\n            >\n              <ArrowLeft className=\"w-3.5 h-3.5\" />\n              <span>Volver</span>\n            </button>\n          )}\n\n          {/* Study Selector Dropdown */}\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs text-zinc-400 font-medium hidden sm:inline\">Estudio Activo:</span>\n            <select\n              value={currentStudy.id}\n              onChange={e => {\n                setSelectedStudyId(e.target.value);\n                setActiveSeriesIndex(0);\n                setSliceIndex(0);\n              }}\n              className=\"bg-zinc-900 border border-zinc-700 text-white text-xs font-medium rounded-md px-3 py-1.5 focus:outline-none focus:border-cyan-500 max-w-xs md:max-w-md truncate\"\n            >\n              {studies.map(st => (\n                <option key={st.id} value={st.id}>\n                  [{st.modality}] {st.patientName} - {st.studyName} ({st.studyDate})\n                </option>\n              ))}\n            </select>\n          </div>\n        </div>\n\n        {/* Right side controls */}\n        <div className=\"flex items-center gap-2\">\n          {/* Dual Split Screen Toggle */}\n          <button\n            onClick={() => setIsDualSplit(!isDualSplit)}\n            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium border transition-colors ${\n              isDualSplit\n                ? \'bg-cyan-950 text-cyan-300 border-cyan-500\'\n                : \'bg-zinc-900 text-zinc-400 border-zinc-800 hover:text-white\'\n            }`}\n            title=\"Comparaci\303\263n lado a lado de dos series\"\n          >\n            <Columns className=\"w-3.5 h-3.5\" />\n            <span className=\"hidden md:inline\">{isDualSplit ? \'Vista \303\232nica\' : \'Comparar (2 Vistas)\'}</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Main Radiology Toolbar */}\n      <ViewerToolbar\n        activeTool={activeTool}\n        onToolChange={setActiveTool}\n        brightness={brightness}\n        contrast={contrast}\n        colormap={colormap}\n        onBrightnessContrastChange={(b, c) => {\n          setBrightness(b);\n          setContrast(c);\n        }}\n        onColormapChange={setColormap}\n        onPresetApply={handleApplyPreset}\n        onResetView={handleResetView}\n        onOpenReportDrawer={() => setShowReportEditor(true)}\n        onOpenPatientExplanation={() => setShowPatientExplanation(true)}\n        hasReport={Boolean(currentStudy.report)}\n      />\n\n      {/* Main Workspace Stage */}\n      <div className=\"flex-1 flex overflow-hidden relative\">\n        {/* Left Series Thumbnail Bar */}\n        <SeriesThumbnailBar\n          series={currentStudy.series}\n          activeSeriesIndex={activeSeriesIndex}\n          onSelectSeries={handleSelectSeries}\n        />\n\n        {/* Viewport Canvas (Single or Dual Split) */}\n        <div className=\"flex-1 flex h-full overflow-hidden bg-black\">\n          {/* Primary Viewport */}\n          <div className=\"flex-1 h-full flex flex-col relative border-r border-zinc-900\">\n            <DicomCanvas\n              study={currentStudy}\n              activeSeries={activeSeries}\n              currentSlice={currentSlice}\n              sliceIndex={sliceIndex}\n              totalSlices={activeSeries.slices.length}\n              onSliceChange={setSliceIndex}\n              activeTool={activeTool}\n              zoom={zoom}\n              pan={pan}\n              brightness={brightness}\n              contrast={contrast}\n              colormap={colormap}\n              onZoomChange={setZoom}\n              onPanChange={setPan}\n              onBrightnessContrastChange={(b, c) => {\n                setBrightness(b);\n                setContrast(c);\n              }}\n              annotations={annotations}\n              onAddAnnotation={handleAddAnnotation}\n              onDeleteAnnotation={handleDeleteAnnotation}\n            />\n          </div>\n\n          {/* Secondary Comparison Viewport (When Dual Split enabled) */}\n          {isDualSplit && (\n            <div className=\"flex-1 h-full flex flex-col relative bg-black\">\n              {/* Secondary Series Bar */}\n              <div className=\"bg-zinc-950/90 px-3 py-1.5 border-b border-zinc-800 flex items-center justify-between text-xs\">\n                <span className=\"text-zinc-400\">Serie Comparativa:</span>\n                <select\n                  value={secondarySeriesIndex}\n                  onChange={e => {\n                    setSecondarySeriesIndex(Number(e.target.value));\n                    setSecondarySliceIndex(0);\n                  }}\n                  className=\"bg-zinc-900 border border-zinc-700 text-zinc-200 rounded px-2 py-0.5 text-xs\"\n                >\n                  {currentStudy.series.map((s, idx) => (\n                    <option key={s.id} value={idx}>\n                      {s.name} ({s.plane})\n                    </option>\n                  ))}\n                </select>\n              </div>\n              <DicomCanvas\n                study={currentStudy}\n                activeSeries={secondarySeries}\n                currentSlice={secondarySlice}\n                sliceIndex={secondarySliceIndex}\n                totalSlices={secondarySeries.slices.length}\n                onSliceChange={setSecondarySliceIndex}\n                activeTool={activeTool}\n                zoom={zoom}\n                pan={pan}\n                brightness={brightness}\n                contrast={contrast}\n                colormap={colormap}\n                onZoomChange={setZoom}\n                onPanChange={setPan}\n                onBrightnessContrastChange={(b, c) => {\n                  setBrightness(b);\n                  setContrast(c);\n                }}\n                annotations={annotations}\n                onAddAnnotation={handleAddAnnotation}\n                onDeleteAnnotation={handleDeleteAnnotation}\n              />\n            </div>\n          )}\n        </div>\n\n        {/* Right Drawer: Radiology Report Editor */}\n        {showReportEditor && (\n          <RadiologyReportEditor\n            study={currentStudy}\n            onSaveReport={rep => {\n              onSaveReport(currentStudy.id, rep);\n            }}\n            onClose={() => setShowReportEditor(false)}\n            onOpenPrintPreview={() => setShowPrintPreview(true)}\n          />\n        )}\n      </div>\n\n      {/* Patient Friendly Explanation Modal */}\n      {showPatientExplanation && (\n        <PatientExplanationModal\n          study={currentStudy}\n          onClose={() => setShowPatientExplanation(false)}\n        />\n      )}\n\n      {/* Printable Report Modal */}\n      {showPrintPreview && (\n        <PrintableReportView\n          study={currentStudy}\n          onClose={() => setShowPrintPreview(false)}\n        />\n      )}\n    </div>\n  );"
