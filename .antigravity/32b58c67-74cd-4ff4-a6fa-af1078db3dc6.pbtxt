  file_change {
    absolute_path_uri: "file:///src/utils/storage.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { Patient, Appointment, MedicalStudy, RadiologyReport } from \'../types\';\nimport { INITIAL_PATIENTS, INITIAL_APPOINTMENTS, INITIAL_STUDIES } from \'../data/initialData\';\n\nconst PATIENTS_STORAGE_KEY = \'consultorio_imagenologia_patients_v1\';\nconst APPOINTMENTS_STORAGE_KEY = \'consultorio_imagenologia_appointments_v1\';\nconst STUDIES_STORAGE_KEY = \'consultorio_imagenologia_studies_v1\';\n\nexport function getStoredPatients(): Patient[] {\n  try {\n    const raw = localStorage.getItem(PATIENTS_STORAGE_KEY);\n    if (!raw) {\n      savePatients(INITIAL_PATIENTS);\n      return INITIAL_PATIENTS;\n    }\n    return JSON.parse(raw);\n  } catch (e) {\n    console.error(\'Error reading patients from storage:\', e);\n    return INITIAL_PATIENTS;\n  }\n}\n\nexport function savePatients(patients: Patient[]): void {\n  try {\n    localStorage.setItem(PATIENTS_STORAGE_KEY, JSON.stringify(patients));\n  } catch (e) {\n    console.error(\'Error saving patients to storage:\', e);\n  }\n}\n\nexport function getStoredAppointments(): Appointment[] {\n  try {\n    const raw = localStorage.getItem(APPOINTMENTS_STORAGE_KEY);\n    if (!raw) {\n      saveAppointments(INITIAL_APPOINTMENTS);\n      return INITIAL_APPOINTMENTS;\n    }\n    return JSON.parse(raw);\n  } catch (e) {\n    console.error(\'Error reading appointments from storage:\', e);\n    return INITIAL_APPOINTMENTS;\n  }\n}\n\nexport function saveAppointments(appointments: Appointment[]): void {\n  try {\n    localStorage.setItem(APPOINTMENTS_STORAGE_KEY, JSON.stringify(appointments));\n  } catch (e) {\n    console.error(\'Error saving appointments to storage:\', e);\n  }\n}\n\nexport function getStoredStudies(): MedicalStudy[] {\n  try {\n    const raw = localStorage.getItem(STUDIES_STORAGE_KEY);\n    if (!raw) {\n      saveStudies(INITIAL_STUDIES);\n      return INITIAL_STUDIES;\n    }\n    return JSON.parse(raw);\n  } catch (e) {\n    console.error(\'Error reading studies from storage:\', e);\n    return INITIAL_STUDIES;\n  }\n}\n\nexport function saveStudies(studies: MedicalStudy[]): void {\n  try {\n    localStorage.setItem(STUDIES_STORAGE_KEY, JSON.stringify(studies));\n  } catch (e) {\n    console.error(\'Error saving studies to storage:\', e);\n  }\n}\n\n// Helpers for adding & updating\nexport function addPatient(patient: Patient): Patient[] {\n  const current = getStoredPatients();\n  const updated = [patient, ...current];\n  savePatients(updated);\n  return updated;\n}\n\nexport function updatePatient(patientId: string, updates: Partial<Patient>): Patient[] {\n  const current = getStoredPatients();\n  const updated = current.map(p => (p.id === patientId ? { ...p, ...updates } : p));\n  savePatients(updated);\n  return updated;\n}\n\nexport function addAppointment(appointment: Appointment): Appointment[] {\n  const current = getStoredAppointments();\n  const updated = [appointment, ...current];\n  saveAppointments(updated);\n  return updated;\n}\n\nexport function updateAppointmentStatus(\n  appointmentId: string,\n  newStatus: Appointment[\'status\'],\n  additionalUpdates?: Partial<Appointment>\n): Appointment[] {\n  const current = getStoredAppointments();\n  const updated = current.map(a =>\n    a.id === appointmentId ? { ...a, status: newStatus, ...additionalUpdates } : a\n  );\n  saveAppointments(updated);\n  return updated;\n}\n\nexport function saveStudyReport(studyId: string, report: RadiologyReport): MedicalStudy[] {\n  const current = getStoredStudies();\n  const updated = current.map(s => {\n    if (s.id === studyId) {\n      return {\n        ...s,\n        report,\n        keyFindingsSummary: report.impression.substring(0, 160) + \'...\',\n      };\n    }\n    return s;\n  });\n  saveStudies(updated);\n\n  // Also update corresponding appointment if exists\n  const apps = getStoredAppointments();\n  const appMatch = apps.find(a => a.associatedStudyId === studyId);\n  if (appMatch) {\n    updateAppointmentStatus(appMatch.id, report.status === \'FIRMADO_FINAL\' ? \'INFORME_FIRMADO\' : \'EN_INTERPRETACION\');\n  }\n\n  return updated;\n}\n"
    }
