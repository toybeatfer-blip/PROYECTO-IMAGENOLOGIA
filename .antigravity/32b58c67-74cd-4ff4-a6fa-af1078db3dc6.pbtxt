ctor: \'Dr. Hern\303\241n Barreto (Gastroenterolog\303\255a)\',\n    clinicalIndication: \'Dolor recurrente en hipocondrio y fosa il\303\255aca derecha, p\303\251rdida de peso no cuantificada.\',\n    requiresContrast: true,\n    patientSafetyVerified: true,\n    prepChecklist: [\n      { id: \'p1\', label: \'Ayuno estricto de 6 horas\', completed: true, mandatory: true },\n      { id: \'p2\', label: \'Creatinina 1.45 mg/dL / eGFR 46 (Protocolo de hidrataci\303\263n oral)\', completed: true, mandatory: true },\n      { id: \'p3\', label: \'Suspensi\303\263n de Metformina confirmada (48h)\', completed: true, mandatory: true },\n      { id: \'p4\', label: \'Ingesta de contraste oral diluido 1 hora antes\', completed: false, mandatory: true },\n    ],\n    notes: \'Paciente se encuentra en sala de espera ingiriendo el medio de contraste oral.\',\n    createdAt: \'2026-08-13\',\n  },\n  {\n    id: \'apt-006\',\n    accessionNumber: \'ACC-2026-0896\',\n    patientId: \'pat-001\',\n    patientName: \'Roberto Carlos Silva\',\n    patientDni: \'45892104\',\n    patientPhone: \'+51 987 654 321\',\n    modality: \'ULTRASONIDO\',\n    studyName: \'Ecograf\303\255a Doppler Carot\303\255deo y Vertebral\',\n    anatomicalRegion: \'Cuello / Vasos de Cuello\',\n    scheduledDate: \'2026-08-15\',\n    scheduledTime: \'09:30\',\n    durationMinutes: 30,\n    status: \'PROGRAMADA\',\n    priority: \'CONTROL\',\n    radiologistName: \'Dra. Carmen Mendoza Lucar\',\n    technologistName: \'Lic. Andr\303\251s Salcedo\',\n    referringDoctor: \'Dr. Alejandro Morales (Neurolog\303\255a)\',\n    clinicalIndication: \'Evaluaci\303\263n de flujo vascular carot\303\255deo y descarte de placas ateromatosas tras cefalea.\',\n    requiresContrast: false,\n    patientSafetyVerified: false,\n    prepChecklist: [\n      { id: \'p1\', label: \'Cuello despejado sin cadenas ni prendas de cuello alto\', completed: false, mandatory: false },\n    ],\n    notes: \'Cita programada para ma\303\261ana por la 