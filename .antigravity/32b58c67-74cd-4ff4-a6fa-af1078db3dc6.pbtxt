    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Patient } from \'../../types\';\nimport {\n  ShieldCheck,\n  KeyRound,\n  User,\n  ArrowRight,\n  Sparkles,\n  Lock,\n  Stethoscope,\n  CheckCircle2,\n  AlertCircle,\n  FileText,\n  Calendar,\n  Layers,\n} from \'lucide-react\';\n\ninterface PatientPortalLoginProps {\n  patients: Patient[];\n  onLogin: (patient: Patient) => void;\n  onBackToStaffPortal: () => void;\n}\n\nexport const PatientPortalLogin: React.FC<PatientPortalLoginProps> = ({\n  patients,\n  onLogin,\n  onBackToStaffPortal,\n}) => {\n  const [dni, setDni] = useState(\'\');\n  const [pin, setPin] = useState(\'\');\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n\n  const handleManualLogin = (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(null);\n\n    const cleanDni = dni.trim();\n    const cleanPin = pin.trim();\n\n    const matched = patients.find(\n      p =>\n        (p.dni === cleanDni || p.documentNumber === cleanDni) &&\n        (p.portalPin === cleanPin || p.portalAccessCode?.toLowerCase() === cleanPin.toLowerCase())\n    );\n\n    if (matched) {\n      onLogin(matched);\n    } else {\n      setErrorMsg(\n        \'Credenciales no v\303\241lidas. Ingrese el DNI y PIN proporcionado en su ticket de admisi\303\263n o haga clic en un paciente de demostraci\303\263n.\'\n      );\n    }\n  };\n\n  const handleQuickLogin = (patient: Patient) => {\n    onLogin(patient);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-neutral-950 text-neutral-200 flex flex-col justify-between select-none\">\n      {/* Top Banner */}\n      <header className=\"border-b border-neutral-800/80 bg-neutral-900/60 backdrop-blur-md px-6 py-3.5 flex items-center justify-between\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-9 h-9 rounded-xl bg-gradient-to-tr from-cyan-600 to-emerald-500 flex items-center justify-center text-white shadow-md\">\n            <Layers className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"font-extrabold text-white text-base tracking-tight\">IMAGIS</span>\n              <span className=\"text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-cyan-950/80 text-cyan-300 border border-cyan-800/80\">\n                Portal de Pacientes\n              </span>\n            </div>\n            <p className=\"text-[11px] text-neutral-400\">\n              Centro Especializado en Diagn\303\263stico por Im\303\241genes & Radiolog\303\255a M\303\251dica\n            </p>\n          </div>\n        </div>\n\n        <button\n          onClick={onBackToStaffPortal}\n          className=\"flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-neutral-800 hover:bg-neutral-700 text-neutral-300 border border-neutral-700 transition-colors\"\n        >\n          <Stethoscope className=\"w-3.5 h-3.5 text-cyan-400\" />\n          <span>Volver a Consola M\303\251dica</span>\n        </button>\n      </header>\n\n      {/* Main Login Area */}\n      <main className=\"flex-1 flex items-center justify-center p-4 sm:p-8\">\n        <div className=\"w-full max-w-4xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\">\n          {/* Left Info Column */}\n          <div className=\"lg:col-span-6 space-y-6\">\n            <div className=\"space-y-3\">\n              <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-cyan-950/80 text-cyan-300 border border-cyan-800\">\n                <ShieldCheck className=\"w-3.5 h-3.5 text-cyan-400\" />\n                <span>Portal Web Seguro para Pacientes</span>\n              </span>\n              <h1 className=\"text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight\">\n                Consulte sus estudios, informes y gestione sus citas\n              </h1>\n              <p className=\"text-sm text-neutral-400 leading-relaxed\">\n                Acceda las 24 horas a sus im\303\241genes diagn\303\263sticas en alta resoluci\303\263n, informes oficiales\n                firmados por radi\303\263logos certificados y solicite nuevas citas con preparaci\303\263n guiada.\n              </p>\n            </div>\n\n            {/* Benefit Highlights */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2\">\n              <div className=\"p-3.5 rounded-xl bg-neutral-900/80 border border-neutral-800 space-y-1\">\n                <div className=\"flex items-center gap-2 text-cyan-400 text-xs font-bold\">\n                  <FileText className=\"w-4 h-4\" />\n                  <span>Informes M\303\251dicos</span>\n                </div>\n                <p className=\"text-[11px] text-neutral-400\">\n                  Descargue sus resultados con firma digital oficial y validez legal.\n                </p>\n              </div>\n\n              <div className=\"p-3.5 rounded-xl bg-neutral-900/80 border border-neutral-800 space-y-1\">\n                <div className=\"flex items-center gap-2 text-emerald-400 text-xs font-bold\">\n                  <Calendar className=\"w-4 h-4\" />\n                  <span>Citas & Recordatorios</span>\n                </div>\n                <p className=\"text-[11px] text-neutral-400\">\n                  Sem\303\241foro de preparaci\303\263n y recordatorios autom\303\241ticos por SMS y correo.\n                </p>\n              </div>\n            </div>\n          </div>\n\n          {/* Right Login Card Column */}\n          <div className=\"lg:col-span-6\">\n            <div className=\"bg-neutral-900/90 border border-neutral-800 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-6\">\n              <div className=\"border-b border-neutral-800 pb-4\">\n                <h2 className=\"text-lg font-bold text-white\">Iniciar Sesi\303\263n de Paciente</h2>\n                <p className=\"text-xs text-neutral-400 mt-0.5\">\n                  Ingrese con su documento de identidad y PIN de acceso\n                </p>\n              </div>\n\n              {errorMsg && (\n                <div className=\"p-3 bg-rose-950/40 border border-rose-800/80 rounded-xl text-rose-300 text-xs flex items-start gap-2.5\">\n                  <AlertCircle className=\"w-4 h-4 shrink-0 mt-0.5\" />\n                  <span>{errorMsg}</span>\n                </div>\n              )}\n\n              <form onSubmit={handleManualLogin} className=\"space-y-4\">\n                <div>\n                  <label className=\"text-xs font-semibold text-neutral-300 block mb-1.5\">\n                    N\303\272mero de Documento (DNI / C\303\251dula):\n                  </label>\n                  <div className=\"relative\">\n                    <User className=\"w-4 h-4 text-neutral-500 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                    <input\n                      type=\"text\"\n                      placeholder=\"Ej. 45892104\"\n                      value={dni}\n                      onChange={e => setDni(e.target.value)}\n                      className=\"w-full bg-neutral-950 border border-neutral-700 rounded-xl pl-10 pr-4 py-2.5 text-xs text-white placeholder:text-neutral-600 focus:outline-hidden focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500\"\n                    />\n                  </div>\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-semibold text-neutral-300 block mb-1.5\">\n                    PIN / C\303\263digo de Acceso \303\232nico:\n                  </label>\n                  <div className=\"relative\">\n                    <KeyRound className=\"w-4 h-4 text-neutral-500 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n                    <input\n                      type=\"password\"\n                      placeholder=\"Ej. 1234 o PAT-4589\"\n                      value={pin}\n                      onChange={e => setPin(e.target.value)}\n                      className=\"w-full bg-neutral-950 border border-neutral-700 rounded-xl pl-10 pr-4 py-2.5 text-xs text-white placeholder:text-neutral-600 focus:outline-hidden focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 font-mono\"\n                    />\n                  </div>\n                  <span className=\"text-[10px] text-neutral-500 mt-1 block\">\n                    El PIN se encuentra en su comprobante o en el SMS de confirmaci\303\263n.\n                  </span>\n                </div>\n\n                <button\n                  type=\"submit\"\n                  className=\"w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-xs font-bold bg-gradient-to-r from-cyan-600 to-emerald-600 hover:from-cyan-500 hover:to-emerald-500 text-white shadow-md transition-all active:scale-[0.99]\"\n                >\n                  <span>Ingresar a Mi Portal</span>\n                  <ArrowRight className=\"w-4 h-4\" />\n                </button>\n              </form>\n\n              {/* Quick Demo Login Buttons */}\n              <div className=\"pt-4 border-t border-neutral-800/80 space-y-2.5\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-[11px] font-bold text-cyan-400 uppercase tracking-wider flex items-center gap-1\">\n                    <Sparkles className=\"w-3 h-3\" />\n                    <span>Acceso R\303\241pido Demo (1-Click)</span>\n                  </span>\n                  <span className=\"text-[10px] text-neutral-500\">Para evaluaci\303\263n inmediata</span>\n                </div>\n\n                <div className=\"grid grid-cols-2 gap-2\">\n                  {patients.slice(0, 4).map(patient => (\n                    <button\n                      key={patient.id}\n                      type=\"button\"\n                      onClick={() => handleQuickLogin(patient)}\n                      className=\"p-2.5 rounded-xl bg-neutral-950 hover:bg-neutral-800 border border-neutral-800 hover:border-cyan-700 text-left transition-all group flex flex-col justify-between\"\n                    >\n                      <div>\n                        <div className=\"font-bold text-xs text-white group-hover:text-cyan-300 truncate\">\n                          {patient.name}\n                        </div>\n                        <div className=\"text-[10px] text-neutral-400\">\n                          DNI: {patient.dni}\n                        </div>\n                      </div>\n                      <div className=\"text-[10px] font-mono text-cyan-400/80 mt-1\">\n                        PIN: {patient.portalPin || \'1234\'}\n                      </div>\n                    </button>\n                  ))}\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </main>\n\n      {/* Footer */}\n      <footer className=\"border-t border-neutral-800/80 bg-neutral-900/40 px-6 py-4 text-center text-xs text-neutral-500 flex flex-col sm:flex-row items-center justify-between gap-2\">\n        <div className=\"flex items-center gap-2\">\n          <Lock className=\"w-3.5 h-3.5 text-emerald-400\" />\n          <span>Conexi\303\263n segura 256-bit SSL | Cumple normativa internacional de privacidad en salud</span>\n        </div>\n        <div>\n          <span>\302\251 2026 IMAGIS Diagn\303\263stico Radiol\303\263gico - Todos los derechos reservados</span>\n        </div>\n      </footer>\n    </div>\n  );\n};\n"
    }
