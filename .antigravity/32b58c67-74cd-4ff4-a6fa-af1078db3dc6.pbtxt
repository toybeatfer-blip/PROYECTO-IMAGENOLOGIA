    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import express, { Request, Response } from \"express\";\nimport path from \"path\";\nimport { createServer as createViteServer } from \"vite\";\nimport { GoogleGenAI } from \"@google/genai\";\nimport dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst app = express();\nconst PORT = 3000;\n\napp.use(express.json({ limit: \"10mb\" }));\n\n// Lazy initializer for Gemini API client\nlet aiClient: GoogleGenAI | null = null;\nfunction getAI(): GoogleGenAI | null {\n  if (!aiClient && process.env.GEMINI_API_KEY) {\n    aiClient = new GoogleGenAI({\n      apiKey: process.env.GEMINI_API_KEY,\n      httpOptions: {\n        headers: {\n          \"User-Agent\": \"aistudio-build\",\n        },\n      },\n    });\n  }\n  return aiClient;\n}\n\n// Health check endpoint\napp.get(\"/api/health\", (_req: Request, res: Response) => {\n  res.json({ status: \"ok\", service: \"Medical Imaging Management System\" });\n});\n\n// Endpoint: Generate structured radiological report\napp.post(\"/api/gemini/generate-report\", async (req: Request, res: Response) => {\n  try {\n    const { patientName, age, gender, modality, studyName, clinicalIndication, keyObservations, priorStudies } = req.body;\n\n    const ai = getAI();\n    if (!ai) {\n      // Fallback generator when API key is not configured\n      const fallbackReport = {\n        technique: `Se realiz\303\263 ${studyName || modality} mediante equipo de alta resoluci\303\263n bajo protocolo est\303\241ndar para ${modality}.`,\n        findings: `Hallazgos principales:\\n- ${keyObservations || \"Estructuras anat\303\263micas evaluadas sin alteraciones morfol\303\263gicas evidentes en cortes axiales, coronales y sagitales.\"}\\n- No se identifican lesiones ocupantes de espacio ni colecciones an\303\263malas.\\n- Relaciones \303\263seas y de tejidos blandos conservadas dentro de los l\303\255mites esperados para la edad del paciente (${age || \"N/A\"} a\303\261os).`,\n        impression: `CONCLUSI\303\223N:\\n1. Estudio de ${studyName || modality} representativo sin signos de patolog\303\255a aguda evolutiva.\\n2. Se correlaciona cl\303\255nicamente con el cuadro referido: \"${clinicalIndication || \"Evaluaci\303\263n diagn\303\263stica\"}\".`,\n        recommendations: \"Correlaci\303\263n con evoluci\303\263n cl\303\255nica y seguimiento seg\303\272n criterio del m\303\251dico tratante.\",\n        biRadsOrScore: modality?.includes(\"Mamograf\303\255a\") ? \"BI-RADS 2 (Benigno)\" : undefined,\n      };\n      return res.json({ success: true, report: fallbackReport, isFallback: true });\n    }\n\n    const systemPrompt = `Eres un M\303\251dico Radi\303\263logo Especialista de alto nivel con amplia experiencia en diagn\303\263stico por im\303\241genes (Rayos X, TAC, RMN, Ecograf\303\255a, Mamograf\303\255a).\nTu tarea es redactar un informe radiol\303\263gico estructurado, profesional, en espa\303\261ol m\303\251dico formal y riguroso.\nUsa terminolog\303\255a t\303\251cnica precisa (t\303\251cnica de adquisici\303\263n, hallazgos por planos anat\303\263micos, conclusi\303\263n/impresi\303\263n diagn\303\263stica, recomendaciones y clasificaci\303\263n diagn\303\263stica est\303\241ndar si aplica, como BI-RADS, Lung-RADS, o Gleason/PIRADS).\n\nDebes devolver EXCLUSIVAMENTE un objeto JSON v\303\241lido con los campos:\n{\n  \"technique\": \"Descripci\303\263n precisa de la t\303\251cnica y secuencias utilizadas\",\n  \"findings\": \"Texto detallado de hallazgos anat\303\263micos divididos l\303\263gicamente\",\n  \"impression\": \"Conclusi\303\263n diagn\303\263stica numerada y contundente\",\n  \"recommendations\": \"Recomendaciones cl\303\255nicas o estudios complementarios\",\n  \"biRadsOrScore\": \"Puntaje/Clasificaci\303\263n est\303\241ndar (ej. BI-RADS 1-6 si es mama, o null)\"\n}`;\n\n    const userPrompt = `Datos del paciente:\n- Nombre: ${patientName || \"Paciente\"}\n- Edad: ${age || \"Adulto\"} a\303\261os | G\303\251nero: ${gender || \"No especificado\"}\n- Modalidad: ${modality}\n- Estudio solicitado: ${studyName}\n- Indicaci\303\263n cl\303\255nica / Sospecha diagn\303\263stica: ${clinicalIndication || \"Control de rutina\"}\n- Notas y observaciones visuales preliminares del radi\303\263logo: ${keyObservations || \"Estudio completado sin incidentes t\303\251cnicos.\"}\n- Antecedentes/Estudios previos: ${priorStudies || \"No se aportan estudios previos para cotejo.\"}\n\nPor favor genera el informe radiol\303\263gico formal.`;\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.7-flash\",\n      contents: userPrompt,\n      config: {\n        systemInstruction: systemPrompt,\n        responseMimeType: \"application/json\",\n        temperature: 0.2,\n      },\n    });\n\n    const text = response.text || \"{}\";\n    let parsed;\n    try {\n      parsed = JSON.parse(text);\n    } catch {\n      parsed = {\n        technique: \"T\303\251cnica est\303\241ndar de adquisici\303\263n multiplanar.\",\n        findings: text,\n        impression: \"Impresi\303\263n diagn\303\263stica seg\303\272n hallazgos descritos.\",\n        recommendations: \"Control cl\303\255nico seg\303\272n criterio m\303\251dico.\",\n      };\n    }\n\n    return res.json({ success: true, report: parsed, isFallback: false });\n  } catch (error: any) {\n    console.error(\"Error generating report with Gemini:\", error);\n    return res.status(500).json({\n      success: false,\n      error: error.message || \"Error al generar el informe con IA\",\n    });\n  }\n});\n\n// Endpoint: Explain medical imaging report in simple words to patient\napp.post(\"/api/gemini/explain-to-patient\", async (req: Request, res: Response) => {\n  try {\n    const { reportText, studyName, patientName } = req.body;\n    const ai = getAI();\n\n    if (!ai) {\n      return res.json({\n        success: true,\n        explanation: `Hola ${patientName || \"estimado paciente\"}, su estudio de ${studyName || \"imagenolog\303\255a\"} fue interpretado por el m\303\251dico especialista. En t\303\251rminos sencillos, el estudio revis\303\263 las estructuras correspondientes para comprobar que se encuentren en buen estado y descartar inflamaci\303\263n o lesiones de cuidado. Le recomendamos llevar este informe oficial con su m\303\251dico tratante para definir los siguientes pasos de su tratamiento.`,\n        isFallback: true,\n      });\n    }\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.7-flash\",\n      contents: `Explica en un lenguaje c\303\241lido, emp\303\241tico, muy claro y 100% entendible para un paciente sin conocimientos m\303\251dicos el siguiente informe de imagenolog\303\255a (${studyName}):\\n\\n${reportText}\\n\\nIncluye: 1. Qu\303\251 se evalu\303\263 en palabras sencillas. 2. Qu\303\251 significa la conclusi\303\263n en su vida diaria. 3. Preguntas \303\272tiles que puede hacerle a su m\303\251dico tratante. Recuerda aclararle que debe siempre consultar a su m\303\251dico tratante.`,\n      config: {\n        systemInstruction: \"Eres un m\303\251dico especialista en comunicaci\303\263n paciente-m\303\251dico que traduce terminolog\303\255a m\303\251dica compleja a un lenguaje accesible, tranquilizador y educativo en espa\303\261ol.\",\n      },\n    });\n\n    return res.json({ success: true, explanation: response.text, isFallback: false });\n  } catch (error: any) {\n    console.error(\"Error explaining report:\", error);\n    return res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Endpoint: Pre-study Safety & Protocol Check (Contrast & MRI screening)\napp.post(\"/api/gemini/safety-check\", async (req: Request, res: Response) => {\n  try {\n    const { modality, contrastRequired, allergies, eGFR, creatinine, hasPacemaker, hasMetalImplants, isPregnant } = req.body;\n    const ai = getAI();\n\n    if (!ai) {\n      const issues: string[] = [];\n      if (modality?.includes(\"Resonancia\") && (hasPacemaker || hasMetalImplants)) {\n        issues.push(\"Alerta Cr\303\255tica: Contraindicaci\303\263n para RMN por presencia de marcapasos o implantes ferromagn\303\251ticos sin certificaci\303\263n MR-Conditional.\");\n      }\n      if (contrastRequired && eGFR && Number(eGFR) < 30) {\n        issues.push(\"Alerta Renal: Tasa de filtraci\303\263n glomerular < 30 mL/min/1.73m\302\262. Riesgo elevado de nefropat\303\255a inducida por contraste o fibrosis sist\303\251mica nefrog\303\251nica.\");\n      }\n      if (contrastRequired && allergies && allergies.toLowerCase().includes(\"yod\")) {\n        issues.push(\"Alerta de Alergia: Antecedente de reacci\303\263n a medio de contraste yodado. Requiere protocolo de premedicaci\303\263n con corticoides y antihistam\303\255nicos.\");\n      }\n\n      return res.json({\n        success: true,\n        cleared: issues.length === 0,\n        alerts: issues,\n        recommendation: issues.length === 0 ? \"Paciente apto bajo protocolo regular de adquisici\303\263n.\" : \"Requiere valoraci\303\263n por el m\303\251dico radi\303\263logo previo al estudio.\",\n        isFallback: true,\n      });\n    }\n\n    const prompt = `Eval\303\272a la seguridad del paciente para el siguiente procedimiento de imagenolog\303\255a:\n- Modalidad: ${modality}\n- Requiere contraste IV: ${contrastRequired ? \"S\303\215\" : \"NO\"}\n- Alergias reportadas: ${allergies || \"Ninguna conocida\"}\n- Funci\303\263n renal: Creatinina ${creatinine || \"N/A\"} mg/dL, eGFR ${eGFR || \"N/A\"} mL/min\n- Marcapasos / Dispositivos card\303\255acos: ${hasPacemaker ? \"S\303\215\" : \"NO\"}\n- Implantes met\303\241licos / clips de aneurisma: ${hasMetalImplants ? \"S\303\215\" : \"NO\"}\n- Embarazo / Sospecha: ${isPregnant ? \"S\303\215\" : \"NO\"}\n\nGenera un JSON con el formato:\n{\n  \"cleared\": boolean,\n  \"riskLevel\": \"Bajo\" | \"Moderado\" | \"Alto\" | \"Cr\303\255tico\",\n  \"alerts\": [\"Lista de advertencias espec\303\255ficas\"],\n  \"recommendations\": \"Instrucciones de preparaci\303\263n o contraindicaciones concretas\",\n  \"preparationGuide\": \"Instrucciones que debe seguir el paciente (ej. horas de ayuno, toma de agua, etc.)\"\n}`;\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.7-flash\",\n      contents: prompt,\n      config: {\n        systemInstruction: \"Eres un especialista en seguridad radiol\303\263gica y protocolos de medios de contraste en imagenolog\303\255a diagn\303\263stica.\",\n        responseMimeType: \"application/json\",\n      },\n    });\n\n    const parsed = JSON.parse(response.text || \"{}\");\n    return res.json({ success: true, ...parsed, isFallback: false });\n  } catch (error: any) {\n    console.error(\"Error in safety check:\", error);\n    return res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Vite middleware & Static serving\nasync function startServer() {\n  if (process.env.NODE_ENV !== \"production\") {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \"spa\",\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), \"dist\");\n    app.use(express.static(distPath));\n    app.get(\"*\", (_req: Request, res: Response) => {\n      res.sendFile(path.join(distPath, \"index.html\"));\n    });\n  }\n\n  app.listen(PORT, \"0.0.0.0\", () => {\n    console.log(`Server running on http://localhost:${PORT}`);\n  });\n}\n\nstartServer();\n"
    }
