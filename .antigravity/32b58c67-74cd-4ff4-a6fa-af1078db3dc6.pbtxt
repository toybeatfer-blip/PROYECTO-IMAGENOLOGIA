          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "\302\277Desea confirmar su asistencia o tiene alguna consulta? Puede ingresar a su Portal del Paciente o responder este mensaje.`,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  defaultSmsTemplate: `IMAGIS: Recordatorio de cita para {nombre_paciente}. Estudio: {estudio} el {fecha_cita} a las {hora_cita}. Recuerde: {indicaciones_preparacion_corta}. Llegar 15 min antes.`,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  templatesByModality: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    TOMOGRAFIA: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      emailText: \'Favor mantener ayuno de 6 horas para el medio de contraste. Traer resultado de creatinina s\303\251rica.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      smsText: \'Ayuno de 6 horas. Traer creatinina reciente. Llegar 15m antes.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      prepNotes: \'Ayuno de 6 horas | Traer creatinina | Suspender Metformina 48h si aplica\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    RESONANCIA: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      emailText: \'Asistir con ropa c\303\263moda sin piezas met\303\241licas. No portar joyas, relojes ni tarjetas magn\303\251ticas.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      smsText: \'Ropa sin metales ni joyas. Notificar si tiene marcapasos.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      prepNotes: \'Sin objetos met\303\241licos | Cuestionario de seguridad en recepci\303\263n | Tapones auditivos provistos\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    RAYOS_X: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      emailText: \'Retirar collares o botones met\303\241licos en la zona a evaluar. No requiere ayuno.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      smsText: \'Sin objetos met\303\241licos en el \303\241rea. No requiere ayuno.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      prepNotes: \'Retiro de accesorios met\303\241licos | Sin ayuno previo\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ULTRASONIDO: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      emailText: \'Si es ecograf\303\255a abdominal: ayuno de 6 horas. Si es p\303\251lvica/vesical: tomar 1L de agua 1 hora antes sin orinar.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      smsText: \'Ayuno 6h (abdominal) o vejiga llena con 1L de agua (p\303\251lvica).\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      prepNotes: \'Abdominal: ayuno 6h | P\303\251lvica: 1L agua 1h antes\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    MAMOGRAFIA: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      emailText: \'No colocarse talco, desodorante ni crema en pecho o axilas. Traer mamograf\303\255as previas.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      smsText: \'Sin desodorante, talco ni cremas. Traer placas anteriores.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      prepNotes: \'Sin desodorante ni talco | Traer estudios previos\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    },"
