    replacement_chunks {
      target_content: "    defaultPrep: [\n      \'Ayuno estricto de 6 horas y dieta baja en carbohidratos el d\303\255a previo\',\n      \'Glucemia capilar previa menor a 150 mg/dL\',\n      \'Reposo absoluto y buena hidrataci\303\263n tras la inyecci\303\263n del radiof\303\241rmaco\',\n    ],\n  },\n};"
      replacement_content: "    defaultPrep: [\n      \'Ayuno estricto de 6 horas y dieta baja en carbohidratos el d\303\255a previo\',\n      \'Glucemia capilar previa menor a 150 mg/dL\',\n      \'Reposo absoluto y buena hidrataci\303\263n tras la inyecci\303\263n del radiof\303\241rmaco\',\n    ],\n  },\n};\n\nexport const INITIAL_NOTIFICATION_SETTINGS: NotificationSettings = {\n  autoSendEnabled: true,\n  emailSenderName: \'IMAGIS Centro de Diagn\303\263stico Radiol\303\263gico\',\n  emailSenderAddress: \'citas@imagis-radiologia.com\',\n  smsSenderId: \'IMAGIS-MED\',\n  includePreparationChecklist: true,\n  rules: [\n    {\n      id: \'rule-48h\',\n      label: \'48 horas antes\',\n      hoursBefore: 48,\n      enabled: true,\n      channels: {\n        email: true,\n        sms: false,\n        whatsapp: true,\n      },\n      customNote: \'Ideal para instrucciones de preparaci\303\263n temprana y suspensi\303\263n de medicamentos.\',\n    },\n    {\n      id: \'rule-24h\',\n      label: \'24 horas antes\',\n      hoursBefore: 24,\n      enabled: true,\n      channels: {\n        email: true,\n        sms: true,\n        whatsapp: true,\n      },\n      customNote: \'Recordatorio principal con hora exacta, sala, ayuno y enlace de confirmaci\303\263n.\',\n    },\n    {\n      id: \'rule-12h\',\n      label: \'12 horas antes\',\n      hoursBefore: 12,\n      enabled: false,\n      channels: {\n        email: false,\n        sms: true,\n        whatsapp: false,\n      },\n      customNote: \'Refuerzo nocturno para citas del primer turno de la ma\303\261ana.\',\n    },\n    {\n      id: \'rule-2h\',\n      label: \'2 horas antes\',\n      hoursBefore: 2,\n      enabled: true,\n      channels: {\n        email: false,\n        sms: true,\n        whatsapp: true,\n      },\n      customNote: \'Aviso de llegada con 15 minutos de anticipaci\303\263n para admisi\303\263n y vestidor.\',\n    },\n  ],\n  defaultEmailTemplate: `Estimado/a {nombre_paciente},\n\nLe recordamos su cita programada en IMAGIS Radiolog\303\255a:\n\n\360\237\223\213 Estudio: {estudio} ({modalidad})\n\360\237\223\205 Fecha: {fecha_cita}\n\342\217\260 Hora: {hora_cita} (presentarse 15 min antes)\n\360\237\223\215 Sede: Sede Central - Sala de {modalidad} (Av. Javier Prado Este 2840)\n\nInstrucciones obligatorias de preparaci\303\263n:\n{indicaciones_preparacion}\n\n\302\277Desea confirmar su asistencia o tiene alguna consulta? Puede ingresar a su Portal del Paciente o responder este mensaje.`,\n  defaultSmsTemplate: `IMAGIS: Recordatorio de cita para {nombre_paciente}. Estudio: {estudio} el {fecha_cita} a las {hora_cita}. Recuerde: {indicaciones_preparacion_corta}. Llegar 15 min antes.`,\n  templatesByModality: {\n    TOMOGRAFIA: {\n      emailText: \'Favor mantener ayuno de 6 horas para el medio de contraste. Traer resultado de creatinina s\303\251rica.\',\n      smsText: \'Ayuno de 6 horas. Traer creatinina reciente. Llegar 15m antes.\',\n      prepNotes: \'Ayuno de 6 horas | Traer creatinina | Suspender Metformina 48h si aplica\',\n    },\n    RESONANCIA: {\n      emailText: \'Asistir con ropa c\303\263moda sin piezas met\303\241licas. No portar joyas, relojes ni tarjetas magn\303\251ticas.\',\n      smsText: \'Ropa sin metales ni joyas. Notificar si tiene marcapasos.\',\n      prepNotes: \'Sin objetos met\303\241licos | Cuestionario de seguridad en recepci\303\263n | Tapones auditivos provistos\',\n    },\n    RAYOS_X: {\n      emailText: \'Retirar collares o botones met\303\241licos en la zona a evaluar. No requiere ayuno.\',\n      smsText: \'Sin objetos met\303\241licos en el \303\241rea. No requiere ayuno.\',\n      prepNotes: \'Retiro de accesorios met\303\241licos | Sin ayuno previo\',\n    },\n    ULTRASONIDO: {\n      emailText: \'Si es ecograf\303\255a abdominal: ayuno de 6 horas. Si es p\303\251lvica/vesical: tomar 1L de agua 1 hora antes sin orinar.\',\n      smsText: \'Ayuno 6h (abdominal) o vejiga llena con 1L de agua (p\303\251lvica).\',\n      prepNotes: \'Abdominal: ayuno 6h | P\303\251lvica: 1L agua 1h antes\',\n    },\n    MAMOGRAFIA: {\n      emailText: \'No colocarse talco, desodorante ni crema en pecho o axilas. Traer mamograf\303\255as previas.\',\n      smsText: \'Sin desodorante, talco ni cremas. Traer placas anteriores.\',\n      prepNotes: \'Sin desodorante ni talco | Traer estudios previos\',\n    },\n  },\n};\n\nexport const INITIAL_NOTIFICATION_LOGS: NotificationLog[] = [\n  {\n    id: \'notif-001\',\n    appointmentId: \'app-001\',\n    patientId: \'pat-001\',\n    patientName: \'Roberto Carlos Silva\',\n    patientDni: \'45892104\',\n    recipient: \'roberto.silva@email.com\',\n    channel: \'EMAIL\',\n    type: \'RECORDATORIO_CITA\',\n    title: \'Recordatorio 24h: TAC Cr\303\241neo Simple y con Contraste\',\n    body: \'Estimado Roberto Carlos Silva, le recordamos su cita para TAC Cr\303\241neo hoy 14/08/2026 a las 09:00 hrs. Ayuno de 6 horas y traer resultado de creatinina.\',\n    status: \'ENTREGADO\',\n    sentAt: \'2026-08-13 09:00\',\n    advanceRuleLabel: \'24 horas antes\',\n    modality: \'TOMOGRAFIA\',\n    studyName: \'TAC Cr\303\241neo Simple y con Contraste\',\n    scheduledDate: \'2026-08-14\',\n    scheduledTime: \'09:00\',\n  },\n  {\n    id: \'notif-002\',\n    appointmentId: \'app-001\',\n    patientId: \'pat-001\',\n    patientName: \'Roberto Carlos Silva\',\n    patientDni: \'45892104\',\n    recipient: \'+51 987 654 321\',\n    channel: \'SMS\',\n    type: \'RECORDATORIO_CITA\',\n    title: \'SMS Recordatorio 2h\',\n    body: \'IMAGIS: Roberto Silva, su TAC Cr\303\241neo es hoy a las 09:00 en Sala TC-1. Presentarse 15 min antes en recepci\303\263n.\',\n    status: \'LEIDO\',\n    sentAt: \'2026-08-14 07:00\',\n    advanceRuleLabel: \'2 horas antes\',\n    modality: \'TOMOGRAFIA\',\n    studyName: \'TAC Cr\303\241neo Simple y con Contraste\',\n    scheduledDate: \'2026-08-14\',\n    scheduledTime: \'09:00\',\n  },\n  {\n    id: \'notif-003\',\n    appointmentId: \'app-002\',\n    patientId: \'pat-002\',\n    patientName: \'Elena Sof\303\255a Morales Vega\',\n    patientDni: \'71452903\',\n    recipient: \'elena.morales@gmail.com\',\n    channel: \'EMAIL\',\n    type: \'RECORDATORIO_CITA\',\n    title: \'Recordatorio 24h: RMN Rodilla Derecha\',\n    body: \'Estimada Elena Sof\303\255a Morales, le confirmamos su cita de Resonancia Magn\303\251tica para hoy a las 10:15 hrs. Asistir con ropa sin metales.\',\n    status: \'ENTREGADO\',\n    sentAt: \'2026-08-13 10:15\',\n    advanceRuleLabel: \'24 horas antes\',\n    modality: \'RESONANCIA\',\n    studyName: \'RMN Rodilla Derecha Alta Definici\303\263n\',\n    scheduledDate: \'2026-08-14\',\n    scheduledTime: \'10:15\',\n  },\n  {\n    id: \'notif-004\',\n    appointmentId: \'app-002\',\n    patientId: \'pat-002\',\n    patientName: \'Elena Sof\303\255a Morales Vega\',\n    patientDni: \'71452903\',\n    recipient: \'+51 912 345 678\',\n    channel: \'WHATSAPP\',\n    type: \'INSTRUCCIONES_PREPARACION\',\n    title: \'WhatsApp Cl\303\255nico: Instrucciones RMN\',\n    body: \'Hola Elena, le compartimos su enlace al cuestionario de seguridad y confirmaci\303\263n de RMN en IMAGIS. Recuerde retirar aretes y piercings.\',\n    status: \'LEIDO\',\n    sentAt: \'2026-08-13 10:16\',\n    advanceRuleLabel: \'24 horas antes\',\n    modality: \'RESONANCIA\',\n    studyName: \'RMN Rodilla Derecha Alta Definici\303\263n\',\n    scheduledDate: \'2026-08-14\',\n    scheduledTime: \'10:15\',\n  },\n  {\n    id: \'notif-005\',\n    appointmentId: \'app-003\',\n    patientId: \'pat-003\',\n    patientName: \'Carlos Andr\303\251s Mendoza Rios\',\n    patientDni: \'80124578\',\n    recipient: \'carlos.mendoza@outlook.com\',\n    channel: \'EMAIL\',\n    type: \'RECORDATORIO_CITA\',\n    title: \'Recordatorio 24h: Radiograf\303\255a de T\303\263rax PA y Lateral\',\n    body: \'Estimado Carlos Andr\303\251s Mendoza, su estudio de Rayos X de T\303\263rax est\303\241 programado para hoy 11:30 hrs. Presentarse en Sala RX-1.\',\n    status: \'ENTREGADO\',\n    sentAt: \'2026-08-13 11:30\',\n    advanceRuleLabel: \'24 horas antes\',\n    modality: \'RAYOS_X\',\n    studyName: \'Radiograf\303\255a de T\303\263rax PA y Lateral\',\n    scheduledDate: \'2026-08-14\',\n    scheduledTime: \'11:30\',\n  },\n];\n\nexport const INITIAL_APPOINTMENT_REQUESTS: PatientAppointmentRequest[] = [\n  {\n    id: \'req-001\',\n    patientId: \'pat-002\',\n    patientName: \'Elena Sof\303\255a Morales Vega\',\n    patientDni: \'71452903\',\n    patientPhone: \'+51 912 345 678\',\n    patientEmail: \'elena.morales@gmail.com\',\n    modality: \'RESONANCIA\',\n    studyName: \'RMN Columna Lumbar\',\n    anatomicalRegion: \'Columna Lumbar\',\n    preferredDate: \'2026-08-18\',\n    preferredTimeSlot: \'MANANA\',\n    clinicalReason: \'Dolor lumbar recurrente irradiado a miembro inferior izquierdo tras esfuerzo f\303\255sico.\',\n    medicalOrderFileName: \'orden_medica_traumatologia_morales.pdf\',\n    hasContrastAllergy: false,\n    hasMetalImplants: true,\n    isPregnant: false,\n    status: \'PENDIENTE_REVISION\',\n    createdAt: \'2026-08-14 08:30\',\n    notes: \'Paciente con pr\303\263tesis dental de titanio compatible.\',\n  },\n  {\n    id: \'req-002\',\n    patientId: \'pat-004\',\n    patientName: \'Valentina Luc\303\255a G\303\263mez Prado\',\n    patientDni: \'38901245\',\n    patientPhone: \'+51 966 543 210\',\n    patientEmail: \'valentina.gomez@gmail.com\',\n    modality: \'MAMOGRAFIA\',\n    studyName: \'Mamograf\303\255a Digital Bilateral 3D con Tomos\303\255ntesis\',\n    anatomicalRegion: \'Mamas Bilateral\',\n    preferredDate: \'2026-08-20\',\n    preferredTimeSlot: \'TARDE\',\n    clinicalReason: \'Chequeo preventivo anual ginecol\303\263gico y cotejo con estudio del a\303\261o 2025.\',\n    medicalOrderFileName: \'orden_ginecologia_dra_ugarte.pdf\',\n    hasContrastAllergy: true,\n    hasMetalImplants: false,\n    isPregnant: false,\n    status: \'PENDIENTE_REVISION\',\n    createdAt: \'2026-08-14 09:15\',\n    notes: \'Antecedente de alergia al iodo (no aplica para mamograf\303\255a est\303\241ndar).\',\n  },\n];"
