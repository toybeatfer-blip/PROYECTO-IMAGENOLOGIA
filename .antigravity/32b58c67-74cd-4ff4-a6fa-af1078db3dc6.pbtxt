        }
        lines {
          text: "      findings: `1. COMPOSICI\303\223N MAMARIA:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Mamas con tejido fibroglandular disperso de densidad heterog\303\251nea (Composici\303\263n tipo B seg\303\272n ACR)."
