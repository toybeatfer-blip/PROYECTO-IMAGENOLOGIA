        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. EVALUACI\303\223N MAMOGR\303\201FICA:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Mama Derecha: Distribuci\303\263n tisular sim\303\251trica. No se observan n\303\263dulos s\303\263lidos dominantes, distorsiones de la arquitectura parenquimatosa ni agrupaciones de microcalcificaciones pleom\303\263rficas sospechosas de malignidad."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Mama Izquierda: No se evidencian lesiones espiculadas ni calcificaciones de morfolog\303\255a sospechosa. Piel y complejo ar\303\251ola-pez\303\263n de aspecto normal."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. CORRELACI\303\223N ECOGR\303\201FICA:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "En radio de las 2 horas de la mama izquierda se observa imagen anecoica, ovalada, circunscrita con refuerzo ac\303\272stico posterior de 6.2 x 4.1 mm, con criterios ecogr\303\241ficos t\303\255picos de quiste simple benigno. No se identifican ganglios axilares de corteza engrosada patol\303\263gica.`,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      impression: `1. HALLAZGOS MAMOGR\303\201FICOS Y ECOGR\303\201FICOS BENIGNOS (QUISTE SIMPLE EN MAMA IZQUIERDA)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. CATEGOR\303\215A BI-RADS 2: HALLAZGO BENIGNO.`,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      recommendations: \'Control mamogr\303\241fico anual de rutina.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      biRadsOrScore: \'BI-RADS 2 (Benigno)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      status: \'FIRMADO_FINAL\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      signedAt: \'2026-08-14 13:00\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
