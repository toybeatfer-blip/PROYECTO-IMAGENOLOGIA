  file_change {
    absolute_path_uri: "file:///src/components/viewer/ViewerToolbar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ViewerToolType, ViewerWindowPreset, ColorMapType } from \'../../types\';\nimport {\n  MousePointer,\n  Move,\n  ZoomIn,\n  SunMedium,\n  Ruler,\n  Compass,\n  CircleDot,\n  ArrowUpRight,\n  Palette,\n  Sparkles,\n  FileText,\n  RotateCcw,\n  Sliders,\n} from \'lucide-react\';\n\ninterface ViewerToolbarProps {\n  activeTool: ViewerToolType;\n  onToolChange: (tool: ViewerToolType) => void;\n  brightness: number;\n  contrast: number;\n  colormap: ColorMapType;\n  onBrightnessContrastChange: (b: number, c: number) => void;\n  onColormapChange: (cm: ColorMapType) => void;\n  onPresetApply: (preset: ViewerWindowPreset) => void;\n  onResetView: () => void;\n  onOpenReportDrawer: () => void;\n  onOpenPatientExplanation: () => void;\n  hasReport: boolean;\n}\n\nexport const ViewerToolbar: React.FC<ViewerToolbarProps> = ({\n  activeTool,\n  onToolChange,\n  brightness,\n  contrast,\n  colormap,\n  onBrightnessContrastChange,\n  onColormapChange,\n  onPresetApply,\n  onResetView,\n  onOpenReportDrawer,\n  onOpenPatientExplanation,\n  hasReport,\n}) => {\n  const tools: { id: ViewerToolType; label: string; icon: React.FC<{ className?: string }> }[] = [\n    { id: \'SELECT\', label: \'Seleccionar (Puntero)\', icon: MousePointer },\n    { id: \'PAN\', label: \'Desplazar (Pan)\', icon: Move },\n    { id: \'ZOOM\', label: \'Zoom Din\303\241mico\', icon: ZoomIn },\n    { id: \'WINDOW_LEVEL\', label: \'Ventana / Nivel (W/L)\', icon: SunMedium },\n    { id: \'RULER\', label: \'Calibrador / Regla (mm)\', icon: Ruler },\n    { id: \'ANGLE\', label: \'Medidor de \303\201ngulo\', icon: Compass },\n    { id: \'ROI\', label: \'Regi\303\263n de Inter\303\251s (ROI HU)\', icon: CircleDot },\n    { id: \'ARROW\', label: \'Flecha de Anotaci\303\263n\', icon: ArrowUpRight },\n  ];\n\n  return (\n    <div className=\"bg-zinc-900 border-b border-zinc-800 px-4 py-2.5 flex flex-wrap items-center justify-between gap-3 select-none\">\n      {/* Group 1: Interactive Viewport Tools */}\n      <div className=\"flex items-center gap-1 bg-zinc-950/70 p-1 rounded-lg border border-zinc-800/80\">\n        {tools.map(tool => {\n          const Icon = tool.icon;\n          const isActive = activeTool === tool.id;\n          return (\n            <button\n              key={tool.id}\n              onClick={() => onToolChange(tool.id)}\n              title={tool.label}\n              className={`flex items-center gap-1.5 px-2.5 py-1.5 rounded-md text-xs font-medium transition-all ${\n                isActive\n                  ? \'bg-cyan-500 text-zinc-950 font-semibold shadow-xs shadow-cyan-500/20\'\n                  : \'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/60\'\n              }`}\n            >\n              <Icon className=\"w-3.5 h-3.5\" />\n              <span className=\"hidden xl:inline\">{tool.label.split(\' \')[0]}</span>\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Group 2: Window / Level Clinical Presets */}\n      <div className=\"flex items-center gap-1.5\">\n        <span className=\"text-[11px] text-zinc-400 font-medium hidden sm:inline flex items-center gap-1\">\n          <Sliders className=\"w-3 h-3 text-zinc-500\" /> Presets W/L:\n        </span>\n        <div className=\"flex items-center gap-1 bg-zinc-950/60 p-1 rounded-lg border border-zinc-800/60\">\n          <button\n            onClick={() => onPresetApply(\'AUTO\')}\n            className=\"px-2 py-1 text-[11px] rounded text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors\"\n          >\n            Auto\n          </button>\n          <button\n            onClick={() => onPresetApply(\'BRAIN\')}\n            className=\"px-2 py-1 text-[11px] rounded text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors\"\n          >\n            Cerebro\n          </button>\n          <button\n            onClick={() => onPresetApply(\'BONE\')}\n            className=\"px-2 py-1 text-[11px] rounded text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors\"\n          >\n            Hueso\n          </button>\n          <button\n            onClick={() => onPresetApply(\'SOFT_TISSUE\')}\n            className=\"px-2 py-1 text-[11px] rounded text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors\"\n          >\n            Tej. Blando\n          </button>\n          <button\n            onClick={() => onPresetApply(\'LUNG\')}\n            className=\"px-2 py-1 text-[11px] rounded text-zinc-300 hover:bg-zinc-800 hover:text-white transition-colors\"\n          >\n            Pulm\303\263n\n          </button>\n        </div>\n      </div>\n\n      {/* Group 3: Color Palette Maps */}\n      <div className=\"flex items-center gap-1.5\">\n        <span className=\"text-[11px] text-zinc-400 font-medium hidden md:inline flex items-center gap-1\">\n          <Palette className=\"w-3 h-3 text-zinc-500\" /> Mapa:\n        </span>\n        <select\n          value={colormap}\n          onChange={e => onColormapChange(e.target.value as ColorMapType)}\n          className=\"bg-zinc-950 border border-zinc-800 text-zinc-200 text-xs rounded-md px-2.5 py-1.5 focus:outline-none focus:border-cyan-500\"\n        >\n          <option value=\"GRAYSCALE\">Escala de Grises (DICOM)</option>\n          <option value=\"INVERTED\">Invertido (Radiograf\303\255a)</option>\n          <option value=\"PET_HOT\">PET / T\303\251rmico</option>\n          <option value=\"DOPPLER\">Doppler Vascular</option>\n          <option value=\"BONE_WARM\">Matiz \303\223seo C\303\241lido</option>\n        </select>\n      </div>\n\n      {/* Group 4: Reporting & AI Assistant Actions */}\n      <div className=\"flex items-center gap-2\">\n        {hasReport && (\n          <button\n            onClick={onOpenPatientExplanation}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 bg-emerald-600/20 text-emerald-400 border border-emerald-500/30 hover:bg-emerald-600/30 text-xs font-medium rounded-lg transition-all\"\n            title=\"Explicar informe al paciente en palabras sencillas asistido por IA\"\n          >\n            <Sparkles className=\"w-3.5 h-3.5\" />\n            <span className=\"hidden sm:inline\">Explicaci\303\263n Paciente</span>\n          </button>\n        )}\n\n        <button\n          onClick={onOpenReportDrawer}\n          className=\"flex items-center gap-1.5 px-3.5 py-1.5 bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-medium rounded-lg shadow-sm shadow-cyan-600/30 transition-all\"\n        >\n          <FileText className=\"w-3.5 h-3.5\" />\n          <span>{hasReport ? \'Ver / Editar Informe\' : \'Redactar Informe\'}</span>\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    }
