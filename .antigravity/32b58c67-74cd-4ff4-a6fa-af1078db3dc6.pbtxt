        }
        lines {
          text: "Menisco Medial: Se identifica una banda lineal hiperintensa de orientaci\303\263n oblicua en el cuerno posterior que alcanza la superficie articular inferior, compatible con rotura meniscal grado III. Cuerno anterior y cuerpo conservados."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "Menisco Lateral: Morfolog\303\255a, contornos y se\303\261al de intensidad homog\303\251nea sin trazos de rotura."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "2. LIGAMENTOS:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "Ligamento Cruzado Anterior (LCA): Fibras continuas y bien orientadas, con se\303\261al conservada."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "Ligamento Cruzado Posterior (LCP): \303\215ntegro, con adecuada curvatura fisiol\303\263gica."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "Ligamentos Colateral Medial (LCM) y Colateral Lateral (LCL): Continuos y sin \303\241reas de desgarro. Tend\303\263n rotuliano y cuadricipital conservados."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "3. CART\303\215LAGO Y ESTRUCTURAS \303\223SEAS:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "Cart\303\255lago femorotibial y femoropatelar con espesor y se\303\261al preservada, sin defectos condrales de espesor completo. No se aprecian fracturas por estr\303\251s ni contusiones \303\263seas agudas significativas en c\303\263ndilos femorales ni meseta tibial."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "4. ESPACIO ARTICULAR:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "Moderada cantidad de l\303\255quido libre intrarticular compatible con derrame articular sin formaci\303\263n de quistes de Baker complicados.`,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      impression: `1. ROTURA OBLICUA GRADO III DEL CUERNO POSTERIOR DEL MENISCO MEDIAL CON COMPROMISO DE LA SUPERFICIE ARTICULAR INFERIOR."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "2. DERRAME ARTICULAR LEVE A MODERADO REACCIONAL."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "3. LIGAMENTOS CRUZADOS Y COLATERALES SIN LESI\303\223N ESTRUCTURAL AGUDA.`,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      recommendations: \'Evaluaci\303\263n por Traumatolog\303\255a y Ortopedia para considerar manejo artrosc\303\263pico vs conservador.\',"
