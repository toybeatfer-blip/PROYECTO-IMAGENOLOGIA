  file_change {
    absolute_path_uri: "file:///src/components/appointments/NewAppointmentModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Patient, Appointment, ModalityType, AppointmentPriority } from \'../../types\';\nimport { MODALITY_CONFIG } from \'../../data/initialData\';\nimport { Calendar, Clock, User, ShieldAlert, X, PlusCircle, CheckCircle2 } from \'lucide-react\';\n\ninterface NewAppointmentModalProps {\n  patients: Patient[];\n  onSaveAppointment: (appointment: Appointment) => void;\n  onClose: () => void;\n  onOpenNewPatientModal: () => void;\n}\n\nexport const NewAppointmentModal: React.FC<NewAppointmentModalProps> = ({\n  patients,\n  onSaveAppointment,\n  onClose,\n  onOpenNewPatientModal,\n}) => {\n  const [selectedPatientId, setSelectedPatientId] = useState<string>(\n    patients[0]?.id || \'\'\n  );\n  const [modality, setModality] = useState<ModalityType>(\'TOMOGRAFIA\');\n  const [studyName, setStudyName] = useState(\'TAC Cr\303\241neo Simple y con Contraste\');\n  const [anatomicalRegion, setAnatomicalRegion] = useState(\'Cr\303\241neo / Enc\303\251falo\');\n  const [scheduledDate, setScheduledDate] = useState(\n    new Date().toISOString().split(\'T\')[0]\n  );\n  const [scheduledTime, setScheduledTime] = useState(\'11:00\');\n  const [durationMinutes, setDurationMinutes] = useState(30);\n  const [priority, setPriority] = useState<AppointmentPriority>(\'RUTINA\');\n  const [requiresContrast, setRequiresContrast] = useState(true);\n  const [referringDoctor, setReferringDoctor] = useState(\'Dr. Alejandro Morales (Neurolog\303\255a)\');\n  const [clinicalIndication, setClinicalIndication] = useState(\'Sospecha cl\303\255nica de proceso expansivo o evento isqu\303\251mico.\');\n  const [radiologistName, setRadiologistName] = useState(\'Dr. V\303\255ctor Hugo Pe\303\261aloza R.\');\n  const [technologistName, setTechnologistName] = useState(\'Lic. Andr\303\251s Salcedo\');\n  const [notes, setNotes] = useState(\'\');\n\n  const selectedPatient = patients.find(p => p.id === selectedPatientId) || patients[0];\n\n  const handleModalityChange = (newMod: ModalityType) => {\n    setModality(newMod);\n    switch (newMod) {\n      case \'RAYOS_X\':\n        setStudyName(\'Radiograf\303\255a de T\303\263rax PA y Lateral\');\n        setAnatomicalRegion(\'T\303\263rax\');\n        setDurationMinutes(15);\n        setRequiresContrast(false);\n        break;\n      case \'TOMOGRAFIA\':\n        setStudyName(\'TAC Abdomen y Pelvis con Contraste\');\n        setAnatomicalRegion(\'Abdomen y Pelvis\');\n        setDurationMinutes(30);\n        setRequiresContrast(true);\n        break;\n      case \'RESONANCIA\':\n        setStudyName(\'RMN de Columna Lumbar 3.0T\');\n        setAnatomicalRegion(\'Columna Lumbar\');\n        setDurationMinutes(45);\n        setRequiresContrast(false);\n        break;\n      case \'ULTRASONIDO\':\n        setStudyName(\'Ecograf\303\255a Abdominal Completa\');\n        setAnatomicalRegion(\'Abdomen Superior\');\n        setDurationMinutes(20);\n        setRequiresContrast(false);\n        break;\n      case \'MAMOGRAFIA\':\n        setStudyName(\'Mamograf\303\255a Digital Bilateral 2D\');\n        setAnatomicalRegion(\'Mama Bilateral\');\n        setDurationMinutes(25);\n        setRequiresContrast(false);\n        break;\n      case \'DENSITOMETRIA\':\n        setStudyName(\'Densitometr\303\255a \303\223sea DEXA\');\n        setAnatomicalRegion(\'Columna y Cadera\');\n        setDurationMinutes(20);\n        setRequiresContrast(false);\n        break;\n      default:\n        break;\n    }\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!selectedPatient) return;\n\n    const defaultPrepItems = MODALITY_CONFIG[modality]?.defaultPrep || [\n      \'Ayuno de 4 horas\',\n      \'Retiro de metales\',\n    ];\n\n    const prepChecklist = defaultPrepItems.map((item, idx) => ({\n      id: `p-${idx + 1}`,\n      label: item,\n      completed: false,\n      mandatory: true,\n    }));\n\n    const newApp: Appointment = {\n      id: \'apt-\' + Date.now(),\n      accessionNumber: `ACC-${new Date().getFullYear()}-${Math.floor(1000 + Math.random() * 9000)}`,\n      patientId: selectedPatient.id,\n      patientName: selectedPatient.fullName,\n      patientDni: selectedPatient.dni,\n      patientPhone: selectedPatient.phone,\n      modality,\n      studyName,\n      anatomicalRegion,\n      scheduledDate,\n      scheduledTime,\n      durationMinutes,\n      status: \'PROGRAMADA\',\n      priority,\n      radiologistName,\n      technologistName,\n      referringDoctor,\n      clinicalIndication,\n      requiresContrast,\n      prepChecklist,\n      patientSafetyVerified: false,\n      notes,\n      createdAt: new Date().toISOString().split(\'T\')[0],\n    };\n\n    onSaveAppointment(newApp);\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-xs select-none\">\n      <div className=\"bg-zinc-900 border border-zinc-700 rounded-2xl w-full max-w-3xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]\">\n        {/* Header */}\n        <div className=\"p-4 bg-gradient-to-r from-cyan-950/60 to-zinc-900 border-b border-zinc-800 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"p-2 bg-cyan-500/10 border border-cyan-500/30 rounded-xl text-cyan-400\">\n              <Calendar className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"text-base font-semibold text-white\">Agendar Nueva Cita de Imagenolog\303\255a</h3>\n              <p className=\"text-xs text-zinc-400\">Asignaci\303\263n de turno, protocolo y preparaci\303\263n</p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 text-zinc-400 hover:text-white hover:bg-zinc-800 rounded-lg transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Form */}\n        <form onSubmit={handleSubmit} className=\"p-5 flex-1 overflow-y-auto space-y-4 text-xs text-zinc-300\">\n          {/* Patient Selector Strip */}\n          <div className=\"bg-zinc-950/70 p-3.5 rounded-xl border border-zinc-800 space-y-2\">\n            <div className=\"flex items-center justify-between\">\n              <label className=\"font-semibold text-zinc-200\">Seleccionar Paciente:</label>\n              <button\n                type=\"button\"\n                onClick={onOpenNewPatientModal}\n                className=\"flex items-center gap-1 text-cyan-400 hover:text-cyan-300 text-xs font-medium\"\n              >\n                <PlusCircle className=\"w-3.5 h-3.5\" />\n                <span>Registrar Nuevo Paciente</span>\n              </button>\n            </div>\n            <select\n              value={selectedPatientId}\n              onChange={e => setSelectedPatientId(e.target.value)}\n              className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg p-2 text-white text-xs focus:outline-none focus:border-cyan-500\"\n            >\n              {patients.map(p => (\n                <option key={p.id} value={p.id}>\n                  {p.fullName} \342\200\224 DNI: {p.dni} ({p.age} a\303\261os)\n                </option>\n              ))}\n            </select>\n            {selectedPatient && (\n              <div className=\"flex items-center gap-4 text-[11px] text-zinc-400 pt-1\">\n                <span>Tel: {selectedPatient.phone}</span>\n                <span>Seguro: {selectedPatient.insuranceProvider}</span>\n                {selectedPatient.safetyProfile.allergies.length > 0 && (\n                  <span className=\"text-amber-400\">\n                    Alergias: {selectedPatient.safetyProfile.allergies.join(\', \')}\n                  </span>\n                )}\n              </div>\n            )}\n          </div>\n\n          {/* Modality Selector Grid */}\n          <div>\n            <label className=\"block text-zinc-400 font-medium mb-1.5\">Modalidad de Imagenolog\303\255a:</label>\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2\">\n              {(Object.keys(MODALITY_CONFIG) as ModalityType[]).map(modKey => {\n                const conf = MODALITY_CONFIG[modKey];\n                const isSelected = modality === modKey;\n                return (\n                  <button\n                    key={modKey}\n                    type=\"button\"\n                    onClick={() => handleModalityChange(modKey)}\n                    className={`p-2.5 rounded-xl border text-left transition-all ${\n                      isSelected\n                        ? \'bg-cyan-950/60 border-cyan-500 text-cyan-300 shadow-xs shadow-cyan-500/20\'\n                        : \'bg-zinc-950/60 border-zinc-800 text-zinc-400 hover:bg-zinc-800 hover:text-white\'\n                    }`}\n                  >\n                    <div className=\"font-semibold text-xs text-white\">{conf.label.split(\' \')[0]}</div>\n                    <div className=\"text-[10px] text-zinc-400 truncate\">{conf.label}</div>\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Study Specific Details */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-zinc-400 mb-1 font-medium\">Nombre del Estudio:</label>\n              <input\n                type=\"text\"\n                required\n                value={studyName}\n                onChange={e => setStudyName(e.target.value)}\n                className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-zinc-400 mb-1 font-medium\">Regi\303\263n Anat\303\263mica:</label>\n              <input\n                type=\"text\"\n                required\n                value={anatomicalRegion}\n                onChange={e => setAnatomicalRegion(e.target.value)}\n                className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n              />\n            </div>\n          </div>\n\n          {/* Schedule Date & Time */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n            <div>\n              <label className=\"block text-zinc-400 mb-1 font-medium\">Fecha de la Cita:</label>\n              <input\n                type=\"date\"\n                required\n                value={scheduledDate}\n                onChange={e => setScheduledDate(e.target.value)}\n                className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-zinc-400 mb-1 font-medium\">Hora del Turno:</label>\n              <input\n                type=\"time\"\n                required\n                value={scheduledTime}\n                onChange={e => setScheduledTime(e.target.value)}\n                className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-zinc-400 mb-1 font-medium\">Duraci\303\263n Estimada:</label>\n              <select\n                value={durationMinutes}\n                onChange={e => setDurationMinutes(Number(e.target.value))}\n                className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n              >\n                <option value={15}>15 minutos (Rayos X)</option>\n                <option value={20}>20 minutos (Ecograf\303\255a/DEXA)</option>\n                <option value={30}>30 minutos (TAC)</option>\n                <option value={45}>45 minutos (RMN)</option>\n                <option value={60}>60 minutos (Estudios Complejos)</option>\n              </select>\n            </div>\n          </div>\n\n          {/* Clinical Indication & Referring Doctor */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-zinc-400 mb-1 font-medium\">M\303\251dico Solicitante / Especialidad:</label>\n              <input\n                type=\"text\"\n                value={referringDoctor}\n                onChange={e => setReferringDoctor(e.target.value)}\n                className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-zinc-400 mb-1 font-medium\">Prioridad:</label>\n              <select\n                value={priority}\n                onChange={e => setPriority(e.target.value as AppointmentPriority)}\n                className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n              >\n                <option value=\"RUTINA\">Rutina (Atenci\303\263n Regular)</option>\n                <option value=\"URGENTE\">Urgente (Atenci\303\263n Prioritaria)</option>\n                <option value=\"CONTROL\">Control Evolutivo</option>\n                <option value=\"STAT_EMERGENCIA\">STAT / Emergencia Inmediata</option>\n              </select>\n            </div>\n          </div>\n\n          <div>\n            <label className=\"block text-zinc-400 mb-1 font-medium\">Indicaci\303\263n Cl\303\255nica / Motivo:</label>\n            <input\n              type=\"text\"\n              required\n              value={clinicalIndication}\n              onChange={e => setClinicalIndication(e.target.value)}\n              className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n            />\n          </div>\n\n          {/* Contrast and Staff Assignment */}\n          <div className=\"bg-zinc-950/60 p-3.5 rounded-xl border border-zinc-800 flex flex-wrap items-center justify-between gap-4\">\n            <label className=\"flex items-center gap-2 cursor-pointer\">\n              <input\n                type=\"checkbox\"\n                checked={requiresContrast}\n                onChange={e => setRequiresContrast(e.target.checked)}\n                className=\"rounded border-zinc-700 text-cyan-500 focus:ring-0 w-4 h-4\"\n              />\n              <span className=\"font-semibold text-white\">Requiere Medio de Contraste Endovenoso / Oral</span>\n            </label>\n            <div className=\"flex items-center gap-4 text-xs\">\n              <div>\n                <span className=\"text-zinc-500 block text-[10px]\">M\303\251dico Radi\303\263logo:</span>\n                <span className=\"font-medium text-zinc-300\">{radiologistName}</span>\n              </div>\n              <div>\n                <span className=\"text-zinc-500 block text-[10px]\">Tecn\303\263logo M\303\251dico:</span>\n                <span className=\"font-medium text-zinc-300\">{technologistName}</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Footer Actions */}\n          <div className=\"p-4 bg-zinc-950 -mx-5 -mb-5 border-t border-zinc-800 flex items-center justify-between mt-4\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded-lg text-xs font-medium transition-colors\"\n            >\n              Cancelar\n            </button>\n            <button\n              type=\"submit\"\n              className=\"flex items-center gap-1.5 px-5 py-2.5 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg text-xs font-semibold shadow-md shadow-cyan-600/30 transition-all\"\n            >\n              <Calendar className=\"w-4 h-4\" />\n              <span>Confirmar y Agendar Cita</span>\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
    }
