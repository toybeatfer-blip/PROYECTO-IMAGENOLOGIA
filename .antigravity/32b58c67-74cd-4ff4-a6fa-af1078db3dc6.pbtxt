      original_chunk {
        target_content: "  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-xs select-none\">\n      <div className=\"bg-zinc-900 border border-zinc-700 rounded-2xl w-full max-w-3xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]\">\n        {/* Header */}\n        <div className=\"p-4 bg-gradient-to-r from-cyan-950/60 to-zinc-900 border-b border-zinc-800 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"p-2 bg-cyan-500/10 border border-cyan-500/30 rounded-xl text-cyan-400\">\n              <Calendar className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"text-base font-semibold text-white\">Agendar Nueva Cita de Imagenolog\303\255a</h3>\n              <p className=\"text-xs text-zinc-400\">Asignaci\303\263n de turno, protocolo y preparaci\303\263n</p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 text-zinc-400 hover:text-white hover:bg-zinc-800 rounded-lg transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Form */}\n        <form onSubmit={handleSubmit} className=\"p-5 flex-1 overflow-y-auto space-y-4 text-xs text-zinc-300\">\n          {/* Patient Selector Strip */}\n          <div className=\"bg-zinc-950/70 p-3.5 rounded-xl border border-zinc-800 space-y-2\">\n            <div className=\"flex items-center justify-between\">\n              <label className=\"font-semibold text-zinc-200\">Seleccionar Paciente:</label>\n              <button\n                type=\"button\"\n                onClick={onOpenNewPatientModal}\n                className=\"flex items-center gap-1 text-cyan-400 hover:text-cyan-300 text-xs font-medium\"\n              >\n                <PlusCircle className=\"w-3.5 h-3.5\" />\n                <span>Registrar Nuevo Paciente</span>\n              </button>\n            </div>\n            <select\n              value={selectedPatientId}\n              onChange={e => setSelectedPatientId(e.target.value)}\n              className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg p-2 text-white text-xs focus:outline-none focus:border-cyan-500\"\n            >\n              {patients.map(p => (\n                <option key={p.id} value={p.id}>\n                  {p.fullName} \342\200\224 DNI: {p.dni} ({p.age} a\303\261os)\n                </option>\n              ))}\n            </select>\n            {selectedPatient && (\n              <div className=\"flex items-center gap-4 text-[11px] text-zinc-400 pt-1\">\n                <span>Tel: {selectedPatient.phone}</span>\n                <span>Seguro: {selectedPatient.insuranceProvider}</span>\n                {selectedPatient.safetyProfile.allergies.length > 0 && (\n                  <span className=\"text-amber-400\">\n                    Alergias: {selectedPatient.safetyProfile.allergies.join(\', \')}\n                  </span>\n                )}\n              </div>\n            )}\n          </div>\n\n          {/* Modality Selector Grid */}\n          <div>\n            <label className=\"block text-zinc-400 font-medium mb-1.5\">Modalidad de Imagenolog\303\255a:</label>\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2\">\n              {(Object.keys(MODALITY_CONFIG) as ModalityType[]).map(modKey => {\n                const conf = MODALITY_CONFIG[modKey];\n                const isSelected = modality === modKey;\n                return (\n                  <button\n                    key={modKey}\n                    type=\"button\"\n                    onClick={() => handleModalityChange(modKey)}\n                    className={`p-2.5 rounded-xl border text-left transition-all ${\n                      isSelected\n                        ? \'bg-cyan-950/60 border-cyan-500 text-cyan-300 shadow-xs shadow-cyan-500/20\'\n                        : \'bg-zinc-950/60 border-zinc-800 text-zinc-400 hover:bg-zinc-800 hover:text-white\'\n                    }`}\n                  >\n                    <div className=\"font-semibold text-xs text-white\">{conf.label.split(\' \')[0]}</div>\n                    <div className=\"text-[10px] text-zinc-400 truncate\">{conf.label}</div>\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Study Specific Details */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-zinc-400 mb-1 font-medium\">Nombre del Estudio:</label>\n              <input\n                type=\"text\"\n                required\n                value={studyName}\n                onChange={e => setStudyName(e.target.value)}\n                className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-zinc-400 mb-1 font-medium\">Regi\303\263n Anat\303\263mica:</label>\n              <input\n                type=\"text\"\n                required\n                value={anatomicalRegion}\n                onChange={e => setAnatomicalRegion(e.target.value)}\n                className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n              />\n            </div>\n          </div>\n\n          {/* Schedule Date & Time */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n            <div>\n              <label className=\"block text-zinc-400 mb-1 font-medium\">Fecha de la Cita:</label>\n              <input\n                type=\"date\"\n                required\n                value={scheduledDate}\n                onChange={e => setScheduledDate(e.target.value)}\n                className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-zinc-400 mb-1 font-medium\">Hora del Turno:</label>\n              <input\n                type=\"time\"\n                required\n                value={scheduledTime}\n                onChange={e => setScheduledTime(e.target.value)}\n                className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-zinc-400 mb-1 font-medium\">Duraci\303\263n Estimada:</label>\n              <select\n                value={durationMinutes}\n                onChange={e => setDurationMinutes(Number(e.target.value))}\n                className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n              >\n                <option value={15}>15 minutos (Rayos X)</option>\n                <option value={20}>20 minutos (Ecograf\303\255a/DEXA)</option>\n                <option value={30}>30 minutos (TAC)</option>\n                <option value={45}>45 minutos (RMN)</option>\n                <option value={60}>60 minutos (Estudios Complejos)</option>\n              </select>\n            </div>\n          </div>\n\n          {/* Clinical Indication & Referring Doctor */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-zinc-400 mb-1 font-medium\">M\303\251dico Solicitante / Especialidad:</label>\n              <input\n                type=\"text\"\n                value={referringDoctor}\n                onChange={e => setReferringDoctor(e.target.value)}\n                className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-zinc-400 mb-1 font-medium\">Prioridad:</label>\n              <select\n                value={priority}\n                onChange={e => setPriority(e.target.value as AppointmentPriority)}\n                className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n              >\n                <option value=\"RUTINA\">Rutina (Atenci\303\263n Regular)</option>\n                <option value=\"URGENTE\">Urgente (Atenci\303\263n Prioritaria)</option>\n                <option value=\"CONTROL\">Control Evolutivo</option>\n                <option value=\"STAT_EMERGENCIA\">STAT / Emergencia Inmediata</option>\n              </select>\n            </div>\n          </div>\n\n          <div>\n            <label className=\"block text-zinc-400 mb-1 font-medium\">Indicaci\303\263n Cl\303\255nica / Motivo:</label>\n            <input\n              type=\"text\"\n              required\n              value={clinicalIndication}\n              onChange={e => setClinicalIndication(e.target.value)}\n              className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n            />\n          </div>\n\n          {/* Contrast and Staff Assignment */}\n          <div className=\"bg-zinc-950/60 p-3.5 rounded-xl border border-zinc-800 flex flex-wrap items-center justify-between gap-4\">\n            <label className=\"flex items-center gap-2 cursor-pointer\">\n              <input\n                type=\"checkbox\"\n                checked={requiresContrast}\n                onChange={e => setRequiresContrast(e.target.checked)}\n                className=\"rounded border-zinc-700 text-cyan-500 focus:ring-0 w-4 h-4\"\n              />\n              <span className=\"font-semibold text-white\