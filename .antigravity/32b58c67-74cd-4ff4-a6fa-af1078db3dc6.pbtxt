      replacement_content: "import React, { useState } from \'react\';\nimport { Patient } from \'../../types\';\nimport { UserPlus, X, ShieldAlert, HeartPulse } from \'lucide-react\';\n\ninterface NewPatientModalProps {\n  onSavePatient: (patient: Patient) => void;\n  onClose: () => void;\n}\n\nexport const NewPatientModal: React.FC<NewPatientModalProps> = ({ onSavePatient, onClose }) => {\n  const [fullName, setFullName] = useState(\'\');\n  const [dni, setDni] = useState(\'\');\n  const [birthDate, setBirthDate] = useState(\'1985-05-15\');\n  const [age, setAge] = useState<number>(41);\n  const [gender, setGender] = useState<\'M\' | \'F\' | \'OTRO\'>(\'M\');\n  const [phone, setPhone] = useState(\'\');\n  const [email, setEmail] = useState(\'\');\n  const [address, setAddress] = useState(\'\');\n  const [bloodType, setBloodType] = useState(\'O+\');\n  const [insuranceProvider, setInsuranceProvider] = useState(\'Particular / Privado\');\n  const [insurancePolicyNumber, setInsurancePolicyNumber] = useState(\'\');\n  const [emergencyContactName, setEmergencyContactName] = useState(\'\');\n  const [emergencyContactPhone, setEmergencyContactPhone] = useState(\'\');\n\n  // Safety profile\n  const [allergiesStr, setAllergiesStr] = useState(\'\');\n  const [creatinineLevel, setCreatinineLevel] = useState<number>(0.9);\n  const [eGFR, setEGFR] = useState<number>(90);\n  const [hasPacemaker, setHasPacemaker] = useState(false);\n  const [hasMetalImplants, setHasMetalImplants] = useState(false);\n  const [isPregnantOrPossible, setIsPregnantOrPossible] = useState(false);\n  const [hasClaustrophobia, setHasClaustrophobia] = useState(false);\n  const [diabeticOnMetformin, setDiabeticOnMetformin] = useState(false);\n  const [priorAdverseReactionToContrast, setPriorAdverseReactionToContrast] = useState(false);\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!fullName || !dni) return;\n\n    const allergies = allergiesStr\n      ? allergiesStr\n          .split(\',\')\n          .map(s => s.trim())\n          .filter(Boolean)\n      : [];\n\n    const newPatient: Patient = {\n      id: \'pat-\' + Date.now(),\n      fullName,\n      dni,\n      birthDate,\n      age: Number(age) || 30,\n      gender,\n      phone,\n      email,\n      address,\n      bloodType,\n      insuranceProvider,\n      insurancePolicyNumber,\n      emergencyContact: {\n        name: emergencyContactName || \'Familiar Directo\',\n        relationship: \'Contacto de Emergencia\',\n        phone: emergencyContactPhone || phone,\n      },\n      safetyProfile: {\n        allergies,\n        creatinineLevel,\n        eGFR,\n        hasPacemaker,\n        hasMetalImplants,\n        isPregnantOrPossible,\n        hasClaustrophobia,\n        diabeticOnMetformin,\n        priorAdverseReactionToContrast,\n      },\n      registeredAt: new Date().toISOString().split(\'T\')[0],\n      history: [],\n    };\n\n    onSavePatient(newPatient);\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-xs select-none\">\n      <div className=\"bg-zinc-900 border border-zinc-700 rounded-2xl w-full max-w-3xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]\">\n        {/* Header */}\n        <div className=\"p-4 bg-gradient-to-r from-cyan-950/60 to-zinc-900 border-b border-zinc-800 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"p-2 bg-cyan-500/10 border border-cyan-500/30 rounded-xl text-cyan-400\">\n              <UserPlus className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"text-base font-semibold text-white\">Registrar Nuevo Paciente</h3>\n              <p className=\"text-xs text-zinc-400\">Ficha cl\303\255nica de filiaci\303\263n y perfil de seguridad radiol\303\263gica</p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 text-zinc-400 hover:text-white hover:bg-zinc-800 rounded-lg transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Form */}\n        <form onSubmit={handleSubmit} className=\"p-5 flex-1 overflow-y-auto space-y-4 text-xs text-zinc-300\">\n          {/* Personal Demographic Data */}\n          <div>\n            <h4 className=\"font-semibold text-white text-xs mb-2 flex items-center gap-1.5\">\n              <HeartPulse className=\"w-4 h-4 text-cyan-400\" />\n              <span>Datos Personales y Contacto</span>\n            </h4>\n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n              <div className=\"sm:col-span-2\">\n                <label className=\"block text-zinc-400 mb-1\">Nombre Completo y Apellidos *</label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"ej. Dra. Elena Quispe Ramos\"\n                  value={fullName}\n                  onChange={e => setFullName(e.target.value)}\n                  className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-zinc-400 mb-1\">DNI / C\303\251dula *</label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"ej. 45892104\"\n                  value={dni}\n                  onChange={e => setDni(e.target.value)}\n                  className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-zinc-400 mb-1\">Edad</label>\n                <input\n                  type=\"number\"\n                  value={age}\n                  onChange={e => setAge(Number(e.target.value))}\n                  className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-zinc-400 mb-1\">G\303\251nero</label>\n                <select\n                  value={gender}\n                  onChange={e => setGender(e.target.value as any)}\n                  className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n                >\n                  <option value=\"M\">Masculino</option>\n                  <option value=\"F\">Femenino</option>\n                  <option value=\"OTRO\">Otro / No especifica</option>\n                </select>\n              </div>\n              <div>\n                <label className=\"block text-zinc-400 mb-1\">Tel\303\251fono M\303\263vil</label>\n                <input\n                  type=\"text\"\n                  placeholder=\"+51 987 654 321\"\n                  value={phone}\n                  onChange={e => setPhone(e.target.value)}\n                  className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n                />\n              </div>\n              <div className=\"sm:col-span-2\">\n                <label className=\"block text-zinc-400 mb-1\">Correo Electr\303\263nico</label>\n                <input\n                  type=\"email\"\n                  placeholder=\"paciente@correo.com\"\n                  value={email}\n                  onChange={e => setEmail(e.target.value)}\n                  className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-zinc-400 mb-1\">Seguro M\303\251dico / EPS</label>\n                <input\n                  type=\"text\"\n                  placeholder=\"ej. Pac\303\255fico EPS / R\303\255mac\"\n                  value={insuranceProvider}\n                  onChange={e => setInsuranceProvider(e.target.value)}\n                  className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n                />\n              </div>\n            </div>\n          </div>\n\n          {/* Safety & Contraindications Profile */}\n          <div className=\"bg-zinc-950/80 p-4 rounded-xl border border-zinc-800 space-y-3\">\n            <h4 className=\"font-semibold text-white text-xs flex items-center gap-1.5\">\n              <ShieldAlert className=\"w-4 h-4 text-amber-400\" />\n              <span>Perfil de Seguridad Radiol\303\263gica y Alergias</span>\n            </h4>\n\n            <div>\n              <label className=\"block text-zinc-400 mb-1\">\n                Alergias conocidas (separar por comas):\n              </label>\n              <input\n                type=\"text\"\n                placeholder=\"ej. Yodo, Penicilina, Mariscos, Ninguna\"\n                value={allergiesStr}\n                onChange={e => setAllergiesStr(e.target.value)}\n                className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-amber-400\"\n              />\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1\">\n              <div>\n                <label className=\"block text-zinc-500 text-[11px]\">Creatinina S\303\251rica (mg/dL)</label>\n                <input\n                  type=\"number\"\n                  step=\"0.01\"\n                  value={creatinineLevel}\n                  onChange={e => setCreatinineLevel(Number(e.target.value))}\n                  className=\"w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 text-white\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-zinc-500 text-[11px]\">eGFR Estimada (mL/min/1.73m\302\262)</label>\n                <input\n                  type=\"number\"\n                  value={eGFR}\n                  onChange={e => setEGFR(Number(e.target.value))}\n                  className=\"w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 text-white\"\n                />\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2 text-xs\">\n              <label className=\"flex items-center gap-2 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={hasPacemaker}\n                  onChange={e => setHasPacemaker(e.target.checked)}\n                  className=\"rounded text-amber-500 focus:ring-0\"\n                />\n                <span>Portador de Marcapasos</span>\n              </label>\n              <label className=\"flex items-center gap-2 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={hasMetalImplants}\n                  onChange={e => setHasMetalImplants(e.target.checked)}\n                  className=\"rounded text-amber-500 focus:ring-0\"\n                />\n                <span>Pr\303\263tesis / Implantes Met\303\241licos</span>\n              </label>\n              <label className=\"flex items-center gap-2 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={isPregnantOrPossible}\n                  onChange={e => setIsPregnantOrPossible(e.target.checked)}\n                  className=\"rounded text-amber-500 focus:ring-0\"\n                />\n                <span>Embarazo / Posible Gestaci\303\263n</span>\n              </label>\n              <label className=\"flex items-center gap-2 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={hasClaustrophobia}\n                  onChange={e => setHasClaustrophobia(e.target.checked)}\n                  className=\"rounded text-amber-500 focus:ring-0\"\n                />\n                <span>Claustrofobia Severa</span>\n              </label>\n            </div>\n          </div>\n\n          {/* Footer */}\n          <div className=\"p-4 bg-zinc-950 -mx-5 -mb-5 border-t border-zinc-800 flex items-center justify-between mt-4\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded-lg text-xs font-medium transition-colors\"\n            >\n              Cancelar\n            </button>\n            <button\n              type=\"submit\"\n              className=\"flex items-center gap-1.5 px-5 py-2.5 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg text-xs font-semibold shadow-md shadow-cyan-600/30 transition-all\"\n            >\n              <UserPlus className=\"w-4 h-4\" />\n              <span>Guardar Ficha del Paciente</span>\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
    }
