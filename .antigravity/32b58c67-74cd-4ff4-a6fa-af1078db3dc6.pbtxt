 placeholder=\"ej. Dra. Elena Quispe Ramos\"\n                  value={fullName}\n                  onChange={e => setFullName(e.target.value)}\n                  className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-zinc-400 mb-1\">DNI / C\303\251dula *</label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"ej. 45892104\"\n                  value={dni}\n                  onChange={e => setDni(e.target.value)}\n                  className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-zinc-400 mb-1\">Edad</label>\n                <input\n                  type=\"number\"\n                  value={age}\n                  onChange={e => setAge(Number(e.target.value))}\n                  className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-zinc-400 mb-1\">G\303\251nero</label>\n                <select\n                  value={gender}\n                  onChange={e => setGender(e.target.value as any)}\n                  className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n                >\n                  <option value=\"M\">Masculino</option>\n                  <option value=\"F\">Femenino</option>\n                  <option value=\"OTRO\">Otro / No especifica</option>\n                </select>\n              </div>\n              <div>\n                <label className=\"block text-zinc-400 mb-1\">Tel\303\251fono M\303\263vil</label>\n                <input\n                  type=\"text\"\n                  placeholder=\"+51 987 654 321\"\n                  value={phone}\n                  onChange={e => setPhone(e.target.value)}\n                  className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n                />\n              </div>\n              <div className=\"sm:col-span-2\">\n                <label className=\"block text-zinc-400 mb-1\">Correo Electr\303\263nico</label>\n                <input\n                  type=\"email\"\n                  placeholder=\"paciente@correo.com\"\n                  value={email}\n                  onChange={e => setEmail(e.target.value)}\n                  className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-zinc-400 mb-1\">Seguro M\303\251dico / EPS</label>\n                <input\n                  type=\"text\"\n                  placeholder=\"ej. Pac\303\255fico EPS / R\303\255mac\"\n                  value={insuranceProvider}\n                  onChange={e => setInsuranceProvider(e.target.value)}\n                  className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-cyan-500\"\n                />\n              </div>\n            </div>\n          </div>\n\n          {/* Safety & Contraindications Profile */}\n          <div className=\"bg-zinc-950/80 p-4 rounded-xl border border-zinc-800 space-y-3\">\n            <h4 className=\"font-semibold text-white text-xs flex items-center gap-1.5\">\n              <ShieldAlert className=\"w-4 h-4 text-amber-400\" />\n              <span>Perfil de Seguridad Radiol\303\263gica y Alergias</span>\n            </h4>\n\n            <div>\n              <label className=\"block text-zinc-400 mb-1\">\n                Alergias conocidas (separar por comas):\n              </label>\n              <input\n                type=\"text\"\n                placeholder=\"ej. Yodo, Penicilina, Mariscos, Ninguna\"\n                value={allergiesStr}\n                onChange={e => setAllergiesStr(e.target.value)}\n                className=\"w-full bg-zinc-900 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-amber-400\"\n              />\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1\">\n              <div>\n                <label className=\"block text-zinc-500 text-[11px]\">Creatinina S\303\251rica (mg/dL)</label>\n                <input\n                  type=\"number\"\n                  step=\"0.01\"\n                  value={creatinineLevel}\n                  onChange={e => setCreatinineLevel(Number(e.target.value))}\n                  className=\"w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 text-white\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-zinc-500 text-[11px]\">eGFR Estimada (mL/min/1.73m\302\262)</label>\n                <input\n                  type=\"number\"\n                  value={eGFR}\n                  onChange={e => setEGFR(Number(e.target.value))}\n                  className=\"w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 text-white\"\n                />\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2 text-xs\">\n              <label className=\"flex items-center gap-2 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={hasPacemaker}\n                  onChange={e => setHasPacemaker(e.target.checked)}\n                  className=\"rounded text-amber-500 focus:ring-0\"\n                />\n                <span>Portador 