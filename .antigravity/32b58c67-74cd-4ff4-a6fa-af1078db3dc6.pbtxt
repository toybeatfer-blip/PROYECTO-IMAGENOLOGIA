          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      className=\"relative flex-1 h-full w-full bg-black overflow-hidden select-none flex items-center justify-center cursor-crosshair group\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      onWheel={handleWheel}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      onMouseDown={handleMouseDown}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      onMouseMove={handleMouseMove}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      onMouseUp={handleMouseUp}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      onMouseLeave={handleMouseUp}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    >"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      {/* HUD: Top Left - Patient & Institutional Info */}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      <div className=\"absolute top-4 left-4 z-20 pointer-events-none text-xs font-mono space-y-0.5 text-cyan-400/90 drop-shadow-[0_1px_2px_rgba(0,0,0,0.9)] bg-black/40 backdrop-blur-xs p-2.5 rounded border border-white/5\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <div className=\"font-semibold text-white tracking-wide text-sm\">{study.patientName}</div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <div className=\"text-neutral-300\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          ID: {study.patientDni} | {study.patientAge}A | {study.patientGender === \'M\' ? \'MASC\' : \'FEM\'}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <div className=\"text-neutral-400\">ACC: {study.accessionNumber}</div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <div className=\"text-emerald-400/90 font-medium\">{study.institutionName}</div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      {/* HUD: Top Right - Acquisition Parameters & Scanner Details */}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      <div className=\"absolute top-4 right-4 z-20 pointer-events-none text-xs font-mono text-right space-y-0.5 text-cyan-400/90 drop-shadow-[0_1px_2px_rgba(0,0,0,0.9)] bg-black/40 backdrop-blur-xs p-2.5 rounded border border-white/5\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <div className=\"font-semibold text-white tracking-wide\">{study.studyName}</div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <div className=\"text-neutral-300\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          {study.studyDate} | {study.studyTime}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <div className=\"text-neutral-400\">{study.equipmentModel}</div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <div className=\"text-amber-400/90 font-mono\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          {study.acquisitionParams.kVp ? `${study.acquisitionParams.kVp} kVp / ${study.acquisitionParams.mA} mA` : \'\'}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          {study.acquisitionParams.magneticFieldStrength || \'\'}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
