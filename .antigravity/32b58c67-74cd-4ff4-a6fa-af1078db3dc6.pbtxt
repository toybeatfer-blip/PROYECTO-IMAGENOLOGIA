    instruction: "Add storage helpers for notifications and appointment requests to storage.ts"
    replacement_infos {
      original_chunk {
        target_content: "import { Patient, Appointment, MedicalStudy, RadiologyReport } from \'../types\';\nimport { INITIAL_PATIENTS, INITIAL_APPOINTMENTS, INITIAL_STUDIES } from \'../data/initialData\';\n\nconst PATIENTS_STORAGE_KEY = \'consultorio_imagenologia_patients_v1\';\nconst APPOINTMENTS_STORAGE_KEY = \'consultorio_imagenologia_appointments_v1\';\nconst STUDIES_STORAGE_KEY = \'consultorio_imagenologia_studies_v1\';\n\nexport function getStoredPatients(): Patient[] {\n  try {\n    const raw = localStorage.getItem(PATIENTS_STORAGE_KEY);\n    if (!raw) {\n      savePatients(INITIAL_PATIENTS);\n      return INITIAL_PATIENTS;\n    }\n    return JSON.parse(raw);\n  } catch (e) {\n    console.error(\'Error reading patients from storage:\', e);\n    return INITIAL_PATIENTS;\n  }\n}\n\nexport function savePatients(patients: Patient[]): void {\n  try {\n    localStorage.setItem(PATIENTS_STORAGE_KEY, JSON.stringify(patients));\n  } catch (e) {\n    console.error(\'Error saving patients to storage:\', e);\n  }\n}\n\nexport function getStoredAppointments(): Appointment[] {\n  try {\n    const raw = localStorage.getItem(APPOINTMENTS_STORAGE_KEY);\n    if (!raw) {\n      saveAppointments(INITIAL_APPOINTMENTS);\n      return INITIAL_APPOINTMENTS;\n    }\n    return JSON.parse(raw);\n  } catch (e) {\n    console.error(\'Error reading appointments from storage:\', e);\n    return INITIAL_APPOINTMENTS;\n  }\n}\n\nexport function saveAppointments(appointments: Appointment[]): void {\n  try {\n    localStorage.setItem(APPOINTMENTS_STORAGE_KEY, JSON.stringify(appointments));\n  } catch (e) {\n    console.error(\'Error saving appointments to storage:\', e);\n  }\n}\n\nexport function getStoredStudies(): MedicalStudy[] {\n  try {\n    const raw = localStorage.getItem(STUDIES_STORAGE_KEY);\n    if (!raw) {\n      saveStudies(INITIAL_STUDIES);\n      return INITIAL_STUDIES;\n    }\n    return JSON.parse(raw);\n  } catch (e) {\n    console.error(\'Error reading studies from storage:\', e);\n    return INITIAL_STUDIES;\n  }\n}\n\nexport function saveStudies(studies: MedicalStudy[]): void {\n  try {\n    localStorage.setItem(STUDIES_STORAGE_KEY, JSON.stringify(studies));\n  } catch (e) {\n    console.error(\'Error saving studies to storage:\', e);\n  }\n}\n\nexport { savePatients as saveStoredPatients, saveAppointments as saveStoredAppointments, saveStudies as saveStoredStudies };"
        replacement_content: "import {\n  Patient,\n  Appointment,\n  MedicalStudy,\n  RadiologyReport,\n  NotificationSettings,\n  NotificationLog,\n  PatientAppointmentRequest,\n} from \'../types\';\nimport {\n  INITIAL_PATIENTS,\n  INITIAL_APPOINTMENTS,\n  INITIAL_STUDIES,\n  INITIAL_NOTIFICATION_SETTINGS,\n  INITIAL_NOTIFICATION_LOGS,\n  INITIAL_APPOINTMENT_REQUESTS,\n} from \'../data/initialData\';\n\nconst PATIENTS_STORAGE_KEY = \'consultorio_imagenologia_patients_v1\';\nconst APPOINTMENTS_STORAGE_KEY = \'consultorio_imagenologia_appointments_v1\';\nconst STUDIES_STORAGE_KEY = \'consultorio_imagenologia_studies_v1\';\nconst NOTIFICATION_SETTINGS_KEY = \'consultorio_imagenologia_notif_settings_v1\';\nconst NOTIFICATION_LOGS_KEY = \'consultorio_imagenologia_notif_logs_v1\';\nconst APPOINTMENT_REQUESTS_KEY = \'consultorio_imagenologia_app_requests_v1\';\n\nexport function getStoredPatients(): Patient[] {\n  try {\n    const raw = localStorage.getItem(PATIENTS_STORAGE_KEY);\n    if (!raw) {\n      savePatients(INITIAL_PATIENTS);\n      return INITIAL_PATIENTS;\n    }\n    return JSON.parse(raw);\n  } catch (e) {\n    console.error(\'Error reading patients from storage:\', e);\n    return INITIAL_PATIENTS;\n  }\n}\n\nexport function savePatients(patients: Patient[]): void {\n  try {\n    localStorage.setItem(PATIENTS_STORAGE_KEY, JSON.stringify(patients));\n  } catch (e) {\n    console.error(\'Error saving patients to storage:\', e);\n  }\n}\n\nexport function getStoredAppointments(): Appointment[] {\n  try {\n    const raw = localStorage.getItem(APPOINTMENTS_STORAGE_KEY);\n    if (!raw) {\n      saveAppointments(INITIAL_APPOINTMENTS);\n      return INITIAL_APPOINTMENTS;\n    }\n    return JSON.parse(raw);\n  } catch (e) {\n    console.error(\'Error reading appointments from storage:\', e);\n    return INITIAL_APPOINTMENTS;\n  }\n}\n\nexport function saveAppointments(appointments: Appointment[]): void {\n  try {\n    localStorage.setItem(APPOINTMENTS_STORAGE_KEY, JSON.stringify(appointments));\n  } catch (e) {\n    console.error(\'Error saving appointments to storage:\', e);\n  }\n}\n\nexport function getStoredStudies(): MedicalStudy[] {\n  try {\n    const raw = localStorage.getItem(STUDIES_STORAGE_KEY);\n    if (!raw) {\n      saveStudies(INITIAL_STUDIES);\n      return INITIAL_STUDIES;\n    }\n    return JSON.parse(raw);\n  } catch (e) {\n    console.error(\'Error reading studies from storage:\', e);\n    return INITIAL_STUDIES;\n  }\n}\n\nexport function saveStudies(studies: MedicalStudy[]): void {\n  try {\n    localStorage.setItem(STUDIES_STORAGE_KEY, JSON.stringify(studies));\n  } catch (e) {\n    console.error(\'Error saving studies to storage:\', e);\n  }\n}\n\nexport function getStoredNotificationSettings(): NotificationSettings {\n  try {\n    const raw = localStorage.getItem(NOTIFICATION_SETTINGS_KEY);\n    if (!raw) {\n      saveStoredNotificationSettings(INITIAL_NOTIFICATION_SETTINGS);\n      return INITIAL_NOTIFICATION_SETTINGS;\n    }\n    return JSON.parse(raw);\n  } catch (e) {\n    console.error(\'Error reading notification settings:\', e);\n    return INITIAL_NOTIFICATION_SETTINGS;\n  }\n}\n\nexport function saveStoredNotificationSettings(settings: NotificationSettings): void {\n  try {\n    localStorage.setItem(NOTIFICATION_SETTINGS_KEY, JSON.stringify(settings));\n  } catch (e) {\n    console.error(\'Error saving notification settings:\', e);\n  }\n}\n\nexport function getStoredNotificationLogs(): NotificationLog[] {\n  try {\n    const raw = localStorage.getItem(NOTIFICATION_LOGS_KEY);\n    if (!raw) {\n      saveStoredNotificationLogs(INITIAL_NOTIFICATION_LOGS);\n      return INITIAL_NOTIFICATION_LOGS;\n    }\n    return JSON.parse(raw);\n  } catch (e) {\n    console.error(\'Error reading notification logs:\', e);\n    return INITIAL_NOTIFICATION_LOGS;\n  }\n}\n\nexport function saveStoredNotificationLogs(logs: NotificationLog[]): void {\n  try {\n    localStorage.setItem(NOTIFICATION_LOGS_KEY, JSON.stringify(logs));\n  } catch (e) {\n    console.error(\'Error saving notification logs:\', e);\n  }\n}\n\nexport function addNotificationLog(log: NotificationLog): NotificationLog[] {\n  const current = getStoredNotificationLogs();\n  const updated = [log, ...current];\n  saveStoredNotificationLogs(updated);\n  return updated;\n}\n\nexport function getStoredAppointmentRequests(): PatientAppointmentRequest[] {\n  try {\n    const raw = localStorage.getItem(APPOINTMENT_REQUESTS_KEY);\n    if (!raw) {\n      saveStoredAppointmentRequests(INITIAL_APPOINTMENT_REQUESTS);\n      return INITIAL_APPOINTMENT_REQUESTS;\n    }\n    return JSON.parse(raw);\n  } catch (e) {\n    console.error(\'Error reading appointment requests:\', e);\n    return INITIAL_APPOINTMENT_REQUESTS;\n  }\n}\n\nexport function saveStoredAppointmentRequests(requests: PatientAppointmentRequest[]): void {\n  try {\n    localStorage.setItem(APPOINTMENT_REQUESTS_KEY, JSON.stringify(requests));\n  } catch (e) {\n    console.error(\'Error saving appointment requests:\', e);\n  }\n}\n\nexport function addAppointmentRequest(req: PatientAppointmentRequest): PatientAppointmentRequest[] {\n  const current = getStoredAppointmentRequests();\n  const updated = [req, ...current];\n  saveStoredAppointmentRequests(updated);\n  return updated;\n}\n\nexport function updateAppointmentRequestStatus(\n  requestId: string,\n  status: PatientAppointmentRequest[\'status\'],\n  assignedAppointmentId?: string\n): PatientAppointmentRequest[] {\n  const current = getStoredAppointmentRequests();\n  const updated = current.map(r =>\n    r.id === requestId\n      ? {\n          ...r,\n          status,\n          reviewedAt: new Date().toISOString().replace(\'T\', \' \').substring(0, 16),\n          assignedAppointmentId: assignedAppointmentId || r.assignedAppointmentId,\n        }\n      : r\n  );\n  saveStoredAppointmentRequests(updated);\n  return updated;\n}\n\nexport {\n  savePatients as saveStoredPatients,\n  saveAppointments as saveStoredAppointments,\n  saveStudies as saveStoredStudies,\n};\n"
      }
      num_matches: 1
    }
  }
}
