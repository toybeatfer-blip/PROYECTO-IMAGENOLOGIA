    replacement_chunks {
      target_content: "    const parsed = JSON.parse(response.text || \"{}\");\n    return res.json({ success: true, ...parsed, isFallback: false });\n  } catch (error: any) {\n    console.error(\"Error in safety check:\", error);\n    return res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Vite middleware & Static serving"
      replacement_content: "    const parsed = JSON.parse(response.text || \"{}\");\n    return res.json({ success: true, ...parsed, isFallback: false });\n  } catch (error: any) {\n    console.error(\"Error in safety check:\", error);\n    return res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Endpoint: Generate specialized patient notification with preparation rules (SMS/Email/WhatsApp)\napp.post(\"/api/notifications/generate-reminder\", async (req: Request, res: Response) => {\n  try {\n    const { patientName, modality, studyName, scheduledDate, scheduledTime, advanceLabel, requiresContrast, allergies } = req.body;\n    const ai = getAI();\n\n    if (!ai) {\n      const emailBody = `Estimado/a ${patientName || \"Paciente\"},\n\nLe recordamos su cita programada en IMAGIS Radiolog\303\255a:\n- Estudio: ${studyName || modality}\n- Fecha: ${scheduledDate || \"Pr\303\263ximamente\"} a las ${scheduledTime || \"09:00\"} hrs\n- Anticipaci\303\263n: ${advanceLabel || \"Recordatorio de cita\"}\n- Indicaci\303\263n de preparaci\303\263n: ${requiresContrast ? \"Ayuno obligatorio de 6 horas para el medio de contraste. Traer estudio previo de creatinina.\" : \"Presentarse con ropa c\303\263moda sin adornos met\303\241licos.\"}\n\nPor favor presentarse con 15 minutos de anticipaci\303\263n con su documento de identidad y orden m\303\251dica.`;\n\n      const smsBody = `IMAGIS: ${patientName}, recordatorio de su ${studyName} el ${scheduledDate} a las ${scheduledTime}. ${requiresContrast ? \"Ayuno de 6 horas.\" : \"Sin objetos met\303\241licos.\"} Llegar 15 min antes.`;\n\n      return res.json({\n        success: true,\n        emailSubject: `Recordatorio de cita m\303\251dica: ${studyName} - ${scheduledDate}`,\n        emailBody,\n        smsBody,\n        isFallback: true,\n      });\n    }\n\n    const prompt = `Genera un recordatorio m\303\251dico claro, emp\303\241tico y profesional para un paciente de imagenolog\303\255a diagn\303\263stica.\nDatos:\n- Paciente: ${patientName}\n- Estudio: ${studyName} (${modality})\n- Fecha y Hora: ${scheduledDate} a las ${scheduledTime}\n- Tipo de Recordatorio: ${advanceLabel || \"24 horas antes\"}\n- Requiere Medio de Contraste: ${requiresContrast ? \"S\303\215\" : \"NO\"}\n- Antecedentes/Alergias: ${allergies || \"Ninguno\"}\n\nDevuelve un JSON con:\n{\n  \"emailSubject\": \"Asunto claro y formal para correo\",\n  \"emailBody\": \"Texto completo y bien estructurado para el correo con saludo, detalles de la cita, preparaci\303\263n paso a paso e instrucciones de llegada\",\n  \"smsBody\": \"Mensaje SMS conciso (m\303\241ximo 160 caracteres) con nombre, estudio, fecha/hora y advertencia clave\",\n  \"prepKeyPoints\": [\"Punto 1\", \"Punto 2\"]\n}`;\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.7-flash\",\n      contents: prompt,\n      config: {\n        systemInstruction: \"Eres el coordinador del centro de atenci\303\263n al paciente de un centro de radiolog\303\255a e imagenolog\303\255a m\303\251dica de prestigio.\",\n        responseMimeType: \"application/json\",\n      },\n    });\n\n    const parsed = JSON.parse(response.text || \"{}\");\n    return res.json({ success: true, ...parsed, isFallback: false });\n  } catch (error: any) {\n    console.error(\"Error generating reminder with AI:\", error);\n    return res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Endpoint: Patient Portal Interactive Virtual Assistant\napp.post(\"/api/portal/chat-assistant\", async (req: Request, res: Response) => {\n  try {\n    const { message, patientName, patientAge, upcomingAppointments, completedStudies } = req.body;\n    const ai = getAI();\n\n    if (!ai) {\n      return res.json({\n        success: true,\n        reply: `Hola ${patientName || \"estimado/a paciente\"}, estoy aqu\303\255 para ayudarte. Si tienes dudas sobre tu preparaci\303\263n (ayuno, metales o contraste) para tus estudios, te recomendamos revisar las indicaciones de tu cita o presentarte 15 minutos antes de la hora acordada. Para emergencias o consultas m\303\251dicas espec\303\255ficas, consulta siempre a tu m\303\251dico tratante.`,\n        isFallback: true,\n      });\n    }\n\n    const contextPrompt = `Contexto del paciente en el portal:\n- Nombre: ${patientName || \"Paciente\"} (${patientAge || \"N/A\"} a\303\261os)\n- Pr\303\263ximas citas: ${JSON.stringify(upcomingAppointments || [])}\n- Estudios previos: ${JSON.stringify(completedStudies || [])}\n\nPregunta o duda del paciente:\n\"${message}\"`;\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.7-flash\",\n      contents: contextPrompt,\n      config: {\n        systemInstruction: `Eres el Asistente Virtual Inteligente del Portal de Pacientes de IMAGIS Radiolog\303\255a.\nTu objetivo es resolver de manera muy emp\303\241tica, tranquilizadora, clara y precisa dudas sobre:\n1. Preparaci\303\263n para estudios de imagen (TAC, RMN, Rayos X, Ecograf\303\255a, Mamograf\303\255a): horas de ayuno, toma de agua, uso de ropa sin metal, retiro de joyas/cosm\303\251ticos.\n2. Procedimientos y qu\303\251 esperar durante el examen (ruidos en RMN, calor leve con contraste en TAC, compresi\303\263n en mamograf\303\255a).\n3. C\303\263mo interpretar sus resultados en t\303\251rminos sencillos sin dar diagn\303\263sticos definitivos (siempre orientando a consultar a su m\303\251dico tratante).\n4. Horarios de atenci\303\263n y tiempos de entrega de informes radiol\303\263gicos.\n\nMant\303\251n un tono c\303\241lido, humano, profesional y en espa\303\261ol claro. Si el paciente pregunta algo no relacionado con salud o con la cl\303\255nica, gu\303\255alo amablemente de vuelta a sus citas o dudas de imagenolog\303\255a.`,\n      },\n    });\n\n    return res.json({ success: true, reply: response.text, isFallback: false });\n  } catch (error: any) {\n    console.error(\"Error in portal chat assistant:\", error);\n    return res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Vite middleware & Static serving"
