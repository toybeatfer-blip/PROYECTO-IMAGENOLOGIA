  file_change {
    absolute_path_uri: "file:///src/components/portal/PatientPortalAIChat.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useRef, useEffect } from \'react\';\nimport { Patient, Appointment, MedicalStudy } from \'../../types\';\nimport {\n  Sparkles,\n  Send,\n  Bot,\n  User,\n  ShieldCheck,\n  Clock,\n  HelpCircle,\n  AlertCircle,\n  Lightbulb,\n} from \'lucide-react\';\nimport { requestPortalChatAssistant } from \'../../utils/geminiService\';\n\ninterface ChatMessage {\n  id: string;\n  sender: \'PATIENT\' | \'BOT\';\n  text: string;\n  timestamp: string;\n}\n\ninterface PatientPortalAIChatProps {\n  patient: Patient;\n  upcomingAppointments: Appointment[];\n  completedStudies: MedicalStudy[];\n}\n\nexport const PatientPortalAIChat: React.FC<PatientPortalAIChatProps> = ({\n  patient,\n  upcomingAppointments,\n  completedStudies,\n}) => {\n  const [messages, setMessages] = useState<ChatMessage[]>([\n    {\n      id: \'msg-1\',\n      sender: \'BOT\',\n      text: `\302\241Hola ${patient.name.split(\' \')[0]}! Soy tu Asistente Virtual de IMAGIS Radiolog\303\255a. \nPuedo orientarte sobre tu preparaci\303\263n para los estudios (ayuno, toma de agua, ropa adecuada), resolver dudas sobre tus citas programadas o explicarte t\303\251rminos de tus informes m\303\251dicos en palabras sencillas. \302\277En qu\303\251 puedo ayudarte hoy?`,\n      timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n    },\n  ]);\n  const [inputValue, setInputValue] = useState(\'\');\n  const [isTyping, setIsTyping] = useState(false);\n  const scrollRef = useRef<HTMLDivElement>(null);\n\n  useEffect(() => {\n    scrollRef.current?.scrollIntoView({ behavior: \'smooth\' });\n  }, [messages, isTyping]);\n\n  const handleSendMessage = async (textToSend?: string) => {\n    const query = textToSend || inputValue;\n    if (!query.trim() || isTyping) return;\n\n    const userMsg: ChatMessage = {\n      id: `msg-${Date.now()}`,\n      sender: \'PATIENT\',\n      text: query,\n      timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n    };\n\n    setMessages(prev => [...prev, userMsg]);\n    setInputValue(\'\');\n    setIsTyping(true);\n\n    try {\n      const response = await requestPortalChatAssistant({\n        message: query,\n        patientName: patient.name,\n        patientAge: patient.age,\n        upcomingAppointments: upcomingAppointments.map(a => ({\n          study: a.studyName,\n          modality: a.modality,\n          date: a.scheduledDate,\n          time: a.scheduledTime,\n          requiresContrast: a.requiresContrast,\n        })),\n        completedStudies: completedStudies.map(s => ({\n          study: s.studyName,\n          modality: s.modality,\n          date: s.studyDate,\n          impression: s.keyFindingsSummary,\n        })),\n      });\n\n      const botMsg: ChatMessage = {\n        id: `msg-${Date.now() + 1}`,\n        sender: \'BOT\',\n        text:\n          response.reply ||\n          \'Te recomendamos verificar las indicaciones de tu cita o presentarte 15 minutos antes. Para dudas espec\303\255ficas sobre tu tratamiento, consulta siempre con tu m\303\251dico.\',\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n      };\n\n      setMessages(prev => [...prev, botMsg]);\n    } catch (err) {\n      console.error(err);\n      const errorMsg: ChatMessage = {\n        id: `msg-${Date.now() + 1}`,\n        sender: \'BOT\',\n        text:\n          \'Hubo una interrupci\303\263n en la conexi\303\263n. Para consultas urgentes de admisi\303\263n, comun\303\255cate con recepci\303\263n de IMAGIS o revisa la secci\303\263n \"Mis Citas\".\',\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n      };\n      setMessages(prev => [...prev, errorMsg]);\n    } finally {\n      setIsTyping(false);\n    }\n  };\n\n  const QUICK_QUESTIONS = [\n    \'\302\277Cu\303\241ntas horas de ayuno necesito para mi estudio?\',\n    \'\302\277Qu\303\251 ropa debo vestir para una resonancia magn\303\251tica?\',\n    \'\302\277Puedo tomar mis pastillas habituales antes del examen?\',\n    \'\302\277Qu\303\251 significa que mi informe diga \"sin alteraciones significativas\"?\',\n  ];\n\n  return (\n    <div className=\"max-w-4xl mx-auto bg-neutral-900 border border-neutral-800 rounded-3xl shadow-xl overflow-hidden flex flex-col h-[680px]\">\n      {/* Top Banner */}\n      <div className=\"bg-gradient-to-r from-cyan-950/70 via-neutral-900 to-neutral-900 p-4 border-b border-neutral-800 flex items-center justify-between\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-10 h-10 rounded-2xl bg-gradient-to-tr from-cyan-500 to-emerald-500 flex items-center justify-center text-white shadow-md\">\n            <Sparkles className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h3 className=\"text-sm font-bold text-white\">Asistente Inteligente del Paciente</h3>\n              <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-emerald-950 text-emerald-300 border border-emerald-800 font-semibold\">\n                Online 24/7\n              </span>\n            </div>\n            <p className=\"text-[11px] text-neutral-400\">\n              Orientaci\303\263n personalizada sobre preparaci\303\263n de estudios, citas y comprensi\303\263n de informes\n            </p>\n          </div>\n        </div>\n\n        <div className=\"hidden sm:flex items-center gap-1.5 text-[11px] text-neutral-400 bg-neutral-950 px-3 py-1.5 rounded-xl border border-neutral-800\">\n          <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n          <span>Privacidad M\303\251dica Protegida</span>\n        </div>\n      </div>\n\n      {/* Messages Scroll Area */}\n      <div className=\"flex-1 p-4 sm:p-6 overflow-y-auto space-y-4 text-xs\">\n        {messages.map(msg => (\n          <div\n            key={msg.id}\n            className={`flex gap-3 max-w-[85%] ${\n              msg.sender === \'PATIENT\' ? \'ml-auto flex-row-reverse\' : \'mr-auto\'\n            }`}\n          >\n            <div\n              className={`w-8 h-8 rounded-xl flex items-center justify-center shrink-0 text-white ${\n                msg.sender === \'PATIENT\'\n                  ? \'bg-cyan-600\'\n                  : \'bg-neutral-800 border border-neutral-700 text-cyan-400\'\n              }`}\n            >\n              {msg.sender === \'PATIENT\' ? (\n                <User className=\"w-4 h-4\" />\n              ) : (\n                <Bot className=\"w-4 h-4\" />\n              )}\n            </div>\n\n            <div className=\"space-y-1\">\n              <div\n                className={`p-4 rounded-2xl leading-relaxed whitespace-pre-line shadow-sm text-xs ${\n                  msg.sender === \'PATIENT\'\n                    ? \'bg-cyan-600 text-white rounded-tr-xs\'\n                    : \'bg-neutral-950 text-neutral-200 border border-neutral-800 rounded-tl-xs\'\n                }`}\n              >\n                {msg.text}\n              </div>\n              <div\n                className={`text-[10px] text-neutral-500 font-mono ${\n                  msg.sender === \'PATIENT\' ? \'text-right\' : \'text-left\'\n                }`}\n              >\n                {msg.timestamp}\n              </div>\n            </div>\n          </div>\n        ))}\n\n        {isTyping && (\n          <div className=\"flex gap-3 max-w-[80%] mr-auto items-center text-xs text-neutral-400 bg-neutral-950 p-3 rounded-2xl border border-neutral-800\">\n            <Sparkles className=\"w-4 h-4 text-cyan-400 animate-spin\" />\n            <span>El asistente m\303\251dico est\303\241 redactando la respuesta...</span>\n          </div>\n        )}\n\n        <div ref={scrollRef} />\n      </div>\n\n      {/* Suggested Quick Questions */}\n      <div className=\"px-4 py-2 bg-neutral-950/80 border-t border-neutral-800/80 flex items-center gap-2 overflow-x-auto text-[11px]\">\n        <span className=\"text-neutral-500 shrink-0 flex items-center gap-1 font-semibold\">\n          <Lightbulb className=\"w-3.5 h-3.5 text-amber-400\" />\n          <span>Sugerencias:</span>\n        </span>\n        {QUICK_QUESTIONS.map((q, idx) => (\n          <button\n            key={idx}\n            onClick={() => handleSendMessage(q)}\n            className=\"px-2.5 py-1 rounded-full bg-neutral-900 hover:bg-neutral-800 text-neutral-300 border border-neutral-800 hover:border-cyan-700 whitespace-nowrap transition-colors\"\n          >\n            {q}\n          </button>\n        ))}\n      </div>\n\n      {/* Input bar */}\n      <div className=\"p-4 bg-neutral-950 border-t border-neutral-800\">\n        <form\n          onSubmit={e => {\n            e.preventDefault();\n            handleSendMessage();\n          }}\n          className=\"flex items-center gap-2\"\n        >\n          <input\n            type=\"text\"\n            placeholder=\"Escriba su consulta m\303\251dica sobre preparaci\303\263n, citas o informes...\"\n            value={inputValue}\n            onChange={e => setInputValue(e.target.value)}\n            className=\"flex-1 bg-neutral-900 border border-neutral-700 rounded-xl px-4 py-2.5 text-xs text-white placeholder:text-neutral-500 focus:outline-hidden focus:border-cyan-500\"\n          />\n          <button\n            type=\"submit\"\n            disabled={!inputValue.trim() || isTyping}\n            className=\"p-2.5 bg-cyan-600 hover:bg-cyan-500 disabled:opacity-40 text-white rounded-xl shadow-md transition-all\"\n          >\n            <Send className=\"w-4 h-4\" />\n          </button>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
    }
