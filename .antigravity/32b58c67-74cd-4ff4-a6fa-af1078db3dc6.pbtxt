    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-xs select-none\">\n      <div className=\"bg-zinc-900 border border-zinc-700 rounded-2xl w-full max-w-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]\">\n        {/* Header */}\n        <div className=\"p-4 bg-gradient-to-r from-amber-950/60 to-zinc-900 border-b border-zinc-800 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"p-2 bg-amber-500/10 border border-amber-500/30 rounded-xl text-amber-400\">\n              <ShieldAlert className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"text-base font-semibold text-white\">Triaje de Seguridad Radiol\303\263gica</h3>\n              <p className=\"text-xs text-zinc-400\">\n                {patient.fullName} | {appointment.studyName}\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 text-zinc-400 hover:text-white hover:bg-zinc-800 rounded-lg transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Questionnaire Form */}\n        <div className=\"p-5 flex-1 overflow-y-auto space-y-4 text-xs text-zinc-300\">\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            {/* Allergies */}\n            <div className=\"col-span-2\">\n              <label className=\"block text-zinc-400 font-medium mb-1\">\n                Alergias Conocidas (Especialmente a Iodo / Gadolinio / Medicamentos)\n              </label>\n              <input\n                type=\"text\"\n                value={allergies}\n                onChange={e => setAllergies(e.target.value)}\n                className=\"w-full bg-zinc-950 border border-zinc-700 rounded-lg p-2 text-white focus:outline-none focus:border-amber-400\"\n              />\n            </div>\n\n            {/* Renal Function for Contrast */}\n            <div className=\"bg-zinc-950/60 p-3 rounded-xl border border-zinc-800/80 space-y-2\">\n              <span className=\"font-semibold text-zinc-200 block\">Funci\303\263n Renal (Contraste IV)</span>\n              <div>\n                <label className=\"block text-zinc-500 text-[11px]\">Creatinina S\303\251rica (mg/dL)</label>\n                <input\n                  type=\"number\"\n                  step=\"0.01\"\n                  value={creatinine || \'\'}\n                  onChange={e => setCreatinine(Number(e.target.value))}\n                  className=\"w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 text-white focus:outline-none\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-zinc-500 text-[11px]\">eGFR Estimada (mL/min/1.73m\302\262)</label>\n                <input\n                  type=\"number\"\n                  value={eGFR || \'\'}\n                  onChange={e => setEGFR(Number(e.target.value))}\n                  className=\"w-full bg-zinc-900 border border-zinc-700 rounded p-1.5 text-white focus:outline-none\"\n                />\n              </div>\n            </div>\n\n            {/* MRI & Ferromagnetic Screening */}\n            <div className=\"bg-zinc-950/60 p-3 rounded-xl border border-zinc-800/80 space-y-2.5\">\n              <span className=\"font-semibold text-zinc-200 block\">Seguridad Magn\303\251tica y Embarazo</span>\n              <label className=\"flex items-center gap-2 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={hasPacemaker}\n                  onChange={e => setHasPacemaker(e.target.checked)}\n                  className=\"rounded border-zinc-700 text-amber-500 focus:ring-0\"\n                />\n                <span>Marcapasos / Dispositivo Card\303\255aco</span>\n              </label>\n              <label className=\"flex items-center gap-2 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={hasMetalImplants}\n                  onChange={e => setHasMetalImplants(e.target.checked)}\n                  className=\"rounded border-zinc-700 text-amber-500 focus:ring-0\"\n                />\n                <span>Implantes met\303\241licos / Pr\303\263tesis</span>\n              </label>\n              <label className=\"flex items-center gap-2 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={isPregnant}\n                  onChange={e => setIsPregnant(e.target.checked)}\n                  className=\"rounded border-zinc-700 text-amber-500 focus:ring-0\"\n                />\n                <span>Embarazo o sospecha</span>\n              </label>\n              <label className=\"flex items-center gap-2 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={diabeticOnMetformin}\n                  onChange={e => setDiabeticOnMetformin(e.target.checked)}\n                  className=\"rounded border-zinc-700 text-amber-500 focus:ring-0\"\n                />\n                <span>Tratamiento con Metformina</span>\n              </label>\n            </div>\n          </div>\n\n          {/* AI Safety Assessment Trigger */}\n          <div className=\"pt-2\">\n            <button\n              onClick={handleRunSafetyEvaluation}\n              disabled={isCheckingAI}\n              className=\"w-full flex items-center justify-center gap-2 py-2.5 px-4 bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-white rounded-xl font-medium transition-all shadow-md\"\n            >\n              <Sparkles className=\"w-4 h-4\" />\n              <span>{isCheckingAI ? \'Evaluando contraindicaciones con IA...\' : \'Verificar Seguridad con IA (Gemini)\'}</span>\n            </button>\n          </div>\n\n          {/* AI Assessment Result Card */}\n          {aiEvaluation && (\n            <div\n              className={`p-4 rounded-xl border space-y-2 ${\n                aiEvaluation.riskLevel === \'Alto\' || aiEvaluation.riskLevel === \'Cr\303\255tico\'\n                  ? \'bg-rose-950/40 border-rose-800/80 text-rose-200\'\n                  : \'bg-emerald-950/40 border-emerald-800/80 text-emerald-200\'\n              }`}\n            >\n              <div className=\"flex items-center justify-between font-semibold text-sm\">\n                <div className=\"flex items-center gap-1.5\">\n                  {aiEvaluation.riskLevel === \'Alto\' ? (\n                    <AlertTriangle className=\"w-4 h-4 text-rose-400\" />\n                  ) : (\n                    <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" />\n                  )}\n                  <span>Nivel de Riesgo: {aiEvaluation.riskLevel || \'Bajo\'}</span>\n                </div>\n                <span className=\"text-xs px-2 py-0.5 rounded bg-black/40\">\n                  {aiEvaluation.cleared ? \'Apto\' : \'Requiere Precauci\303\263n\'}\n                </span>\n              </div>\n\n              {aiEvaluation.alerts && aiEvaluation.alerts.length > 0 && (\n                <ul className=\"list-disc list-inside text-xs space-y-0.5\">\n                  {aiEvaluation.alerts.map((al, idx) => (\n                    <li key={idx}>{al}</li>\n                  ))}\n                </ul>\n              )}\n\n              {aiEvaluation.recommendations && (\n                <p className=\"text-xs italic text-zinc-300\">\n                  Recomendaci\303\263n cl\303\255nica: {aiEvaluation.recommendations}\n                </p>\n              )}\n\n              {aiEvaluation.preparationGuide && (\n                <div className=\"text-[11px] bg-black/30 p-2 rounded text-zinc-300\">\n                  Gu\303\255a de preparaci\303\263n: {aiEvaluation.preparationGuide}\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n\n        {/* Footer */}\n        <div className=\"p-4 bg-zinc-950 border-t border-zinc-800 flex items-center justify-between\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded-lg text-xs font-medium transition-colors\"\n          >\n            Cancelar\n          </button>\n\n          <button\n            onClick={handleConfirm}\n            className=\"flex items-center gap-1.5 px-5 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-semibold shadow-sm transition-all\"\n          >\n            <ShieldCheck className=\"w-4 h-4\" />\n            <span>Aprobar y Registrar Triaje de Seguridad</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );"
        replacement_content: "  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-xs select-none\">\n      <div className=\"bg-neutral-900 border border-neutral-700 rounded-2xl w-full max-w-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]\">\n        {/* Header */}\n        <div className=\"p-4 bg-gradient-to-r from-amber-950/60 to-neutral-900 border-b border-neutral-800 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"p-2 bg-amber-500/10 border border-amber-500/30 rounded-xl text-amber-400\">\n              <ShieldAlert className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"text-base font-semibold text-white\">Triaje de Seguridad Radiol\303\263gica</h3>\n              <p className=\"text-xs text-neutral-400\">\n                {patient.fullName} | {appointment.studyName}\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 text-neutral-400 hover:text-white hover:bg-neutral-800 rounded-lg transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Questionnaire Form */}\n        <div className=\"p-5 flex-1 overflow-y-auto space-y-4 text-xs text-neutral-300\">\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            {/* Allergies */}\n            <div className=\"col-span-2\">\n              <label className=\"block text-neutral-400 font-medium mb-1\">\n                Alergias Conocidas (Especialmente a Iodo / Gadolinio / Medicamentos)\n              </label>\n              <input\n                type=\"text\"\n                value={allergies}\n                onChange={e => setAllergies(e.target.value)}\n                className=\"w-full bg-neutral-950 border border-neutral-700 rounded-lg p-2 text-white focus:outline-none focus:border-amber-400\"\n              />\n            </div>\n\n            {/* Renal Function for Contrast */}\n            <div className=\"bg-neutral-950/60 p-3 rounded-xl border border-neutral-800/80 space-y-2\">\n              <span className=\"font-semibold text-neutral-200 block\">Funci\303\263n Renal (Contraste IV)</span>\n              <div>\n                <label className=\"block text-neutral-500 text-[11px]\">Creatinina S\303\251rica (mg/dL)</label>\n                <input\n                  type=\"number\"\n                  step=\"0.01\"\n                  value={creatinine || \'\'}\n                  onChange={e => setCreatinine(Number(e.target.value))}\n                  className=\"w-full bg-neutral-900 border border-neutral-700 rounded p-1.5 text-white focus:outline-none\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-neutral-500 text-[11px]\">eGFR Estimada (mL/min/1.73m\302\262)</label>\n                <input\n                  type=\"number\"\n                  value={eGFR || \'\'}\n                  onChange={e => setEGFR(Number(e.target.value))}\n                  className=\"w-full bg-neutral-900 border border-neutral-700 rounded p-1.5 text-white focus:outline-none\"\n                />\n              </div>\n            </div>\n\n            {/* MRI & Ferromagnetic Screening */}\n            <div className=\"bg-neutral-950/60 p-3 rounded-xl border border-neutral-800/80 space-y-2.5\">\n              <span className=\"font-semibold text-neutral-200 block\">Seguridad Magn\303\251tica y Embarazo</span>\n              <label className=\"flex items-center gap-2 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={hasPacemaker}\n                  onChange={e => setHasPacemaker(e.target.checked)}\n                  className=\"rounded border-neutral-700 text-amber-500 focus:ring-0\"\n                />\n                <span>Marcapasos / Dispositivo Card\303\255aco</span>\n              </label>\n              <label className=\"flex items-center gap-2 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={hasMetalImplants}\n                  onChange={e => setHasMetalImplants(e.target.checked)}\n                  className=\"rounded border-neutral-700 text-amber-500 focus:ring-0\"\n                />\n                <span>Implantes met\303\241licos / Pr\303\263tesis</span>\n              </label>\n              <label className=\"flex items-center gap-2 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={isPregnant}\n                  onChange={e => setIsPregnant(e.target.checked)}\n                  className=\"rounded border-neutral-700 text-amber-500 focus:ring-0\"\n                />\n                <span>Embarazo o sospecha</span>\n              </label>\n              <label className=\"flex items-center gap-2 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={diabeticOnMetformin}\n                  onChange={e => setDiabeticOnMetformin(e.target.checked)}\n                  className=\"rounded border-neutral-700 text-amber-500 focus:ring-0\"\n                />\n                <span>Tratamiento con Metformina</span>\n              </label>\n            </div>\n          </div>\n\n          {/* AI Safety Assessment Trigger */}\n          <div className=\"pt-2\">\n            <button\n              onClick={handleRunSafetyEvaluation}\n              disabled={isCheckingAI}\n              className=\"w-full flex items-center justify-center gap-2 py-2.5 px-4 bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-white rounded-xl font-medium transition-all shadow-md\"\n            >\n              <Sparkles className=\"w-4 h-4\" />\n              <span>{isCheckingAI ? \'Evaluando contraindicaciones con IA...\' : \'Verificar Seguridad con IA (Gemini)\'}</span>\n            </button>\n          </div>\n\n          {/* AI Assessment Result Card */}\n          {aiEvaluation && (\n            <div\n              className={`p-4 rounded-xl border space-y-2 ${\n                aiEvaluation.riskLevel === \'Alto\' || aiEvaluation.riskLevel === \'Cr\303\255tico\'\n                  ? \'bg-rose-950/40 border-rose-800/80 text-rose-200\'\n                  : \'bg-emerald-950/40 border-emerald-800/80 text-emerald-200\'\n              }`}\n            >\n              <div className=\"flex items-center justify-between font-semibold text-sm\">\n                <div className=\"flex items-center gap-1.5\">\n                  {aiEvaluation.riskLevel === \'Alto\' ? (\n                    <AlertTriangle className=\"w-4 h-4 text-rose-400\" />\n                  ) : (\n                    <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" />\n                  )}\n                  <span>Nivel de Riesgo: {aiEvaluation.riskLevel || \'Bajo\'}</span>\n                </div>\n                <span className=\"text-xs px-2 py-0.5 rounded bg-black/40\">\n                  {aiEvaluation.cleared ? \'Apto\' : \'Requiere Precauci\303\263n\'}\n                </span>\n              </div>\n\n              {aiEvaluation.alerts && aiEvaluation.alerts.length > 0 && (\n                <ul className=\"list-disc list-inside text-xs space-y-0.5\">\n                  {aiEvaluation.alerts.map((al, idx) => (\n                    <li key={idx}>{al}</li>\n                  ))}\n                </ul>\n              )}\n\n              {aiEvaluation.recommendations && (\n                <p className=\"text-xs italic text-neutral-300\">\n                  Recomendaci\303\263n cl\303\255nica: {aiEvaluation.recommendations}\n                </p>\n              )}\n\n              {aiEvaluation.preparationGuide && (\n                <div className=\"text-[11px] bg-black/30 p-2 rounded text-neutral-300\">\n                  Gu\303\255a de preparaci\303\263n: {aiEvaluation.preparationGuide}\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n\n        {/* Footer */}\n        <div className=\"p-4 bg-neutral-950 border-t border-neutral-800 flex items-center justify-between\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-300 rounded-lg text-xs font-medium transition-colors\"\n          >\n            Cancelar\n          </button>\n\n          <button\n            onClick={handleConfirm}\n            className=\"flex items-center gap-1.5 px-5 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-semibold shadow-sm transition-all\"\n          >\n            <ShieldCheck className=\"w-4 h-4\" />\n            <span>Aprobar y Registrar Triaje de Seguridad</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );"
      }
      num_matches: 1
    }
  }
}
