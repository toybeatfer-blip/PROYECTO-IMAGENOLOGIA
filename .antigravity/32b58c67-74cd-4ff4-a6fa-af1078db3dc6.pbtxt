center font-bold text-white text-lg shadow-md\">\n                {patient.fullName.substring(0, 2).toUpperCase()}\n              </div>\n              <div>\n                <h3 className=\"text-base font-bold text-white\">{patient.fullName}</h3>\n                <div className=\"flex items-center gap-3 text-xs text-zinc-400 mt-0.5\">\n                  <span className=\"font-mono text-zinc-300\">DNI: {patient.dni}</span>\n                  <span>\342\200\242 {patient.age} a\303\261os</span>\n                  <span>\342\200\242 {patient.gender === \'M\' ? \'Masculino\' : \'Femenino\'}</span>\n                  <span>\342\200\242 Grupo Sangu\303\255neo: {patient.bloodType}</span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"flex flex-wrap items-center gap-2 text-xs\">\n              <div className=\"bg-zinc-950 px-3 py-1.5 rounded-lg border border-zinc-800 text-zinc-300\">\n                <span className=\"text-zinc-500 block text-[10px]\">Seguro / EPS:</span>\n                <span className=\"font-semibold text-cyan-400\">{patient.insuranceProvider}</span>\n              </div>\n              <div className=\"bg-zinc-950 px-3 py-1.5 rounded-lg border border-zinc-800 text-zinc-300\">\n                <span className=\"text-zinc-500 block text-[10px]\">Registro Inicial:</span>\n                <span>{patient.createdAt}</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Contact Details Grid */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs text-zinc-300\">\n            <div className=\"flex items-center gap-2 bg-zinc-950/60 p-2.5 rounded-lg border border-zinc-800/60\">\n              <Phone className=\"w-4 h-4 text-zinc-500\" />\n              <span>{patient.phone || \'Sin tel\303\251fono registrado\'}</span>\n            </div>\n            <div className=\"flex items-center gap-2 bg-zinc-950/60 p-2.5 rounded-lg border border-zinc-800/60\">\n              <Mail className=\"w-4 h-4 text-zinc-500\" />\n              <span className=\"truncate\">{patient.email || \'Sin correo registrado\'}</span>\n            </div>\n            <div className=\"flex items-center gap-2 bg-zinc-950/60 p-2.5 rounded-lg border border-zinc-800/60\">\n              <MapPin className=\"w-4 h-4 text-zinc-500\" />\n              <span className=\"truncate\">{patient.address || \'Lima, Per\303\272\'}</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Safety & Pre-Imaging Protocol Screening Banner */}\n        <div className=\"bg-gradient-to-r from-zinc-900 to-zinc-950 border border-zinc-800 rounded-2xl p-5 shadow-lg space-y-3\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-2 text-sm font-bold text-white\">\n              <ShieldCheck className=\"w-5 h-5 text-emerald-400\" />\n              <span>Perfil de Seguridad y Precauciones Radiol\303\263gicas</span>\n            </div>\n            <span className=\"text-xs text-zinc-400 font-mono\">\303\232ltima actualizaci\303\263n: Agosto 2026</span>\n          </div>\n\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs\">\n            {/* Allergies */}\n            <div\n              className={`p-3 rounded-xl border ${\n                patient.safetyProfile.allergies.length > 0\n                  ? \'bg-rose-950/30 border-rose-800/60 text-rose-200\'\n                  : \'bg-zinc-950/70 border-zinc-800 text-zinc-300\'\n              }`}\n            >\n              <span className=\"text-[10px] text-zinc-400 block font-medium\">Alergias Conocidas</span>\n              <span className=\"font-bold text-xs mt-0.5 block\">\n                {patient.safetyProfile.allergies.length > 0\n                  ? patient.safetyProfile.allergies.join(\', \')\n                  : \'Sin alergias registradas\'}\n              </span>\n            </div>\n\n            {/* Renal Function (eGFR) */}\n            <div className=\"bg-zinc-950/70 border border-zinc-800 p-3 rounded-xl text-zinc-300\">\n              <span className=\"text-[10px] text-zinc-400 block font-medium\">Funci\303\263n Renal (eGFR)</span>\n              <div className=\"flex items-baseline gap-1 mt-0.5\">\n                <span className=\"font-bold text-white text-sm\">{patient.safetyProfile.eGFR || 90}</span>\n                <span className=\"text-[10px] text-zinc-400\">mL/min</span>\n                <span className=\"text-[10px] text-emerald-400 ml-auto font-medium\">\n                  {patient.safetyProfile.eGFR && patient.safetyProfile.eGFR > 60 ? \'Normal\' : \'Observaci\303\263n\'}\n                </span>\n              </div>\n            </div>\n\n            {/* Pacemaker */}\n            <div\n              className={`p-3 rounded-xl border ${\n                patient.safetyProfile.hasPacemaker\n                  ? \'bg-rose-950/40 border-rose-800 text-rose-300\'\n                  : \'bg-zinc-950/70 border-zinc-800 text-zinc-300\'\n              }`}\n            >\n              <span className=\"text-[10px] text-zinc-400 block font-medium\">Marcapasos / Implante RMN</span>\n              <span className=\"font-bold text-xs mt-0.5 block\">\n                {patient.safetyProfile.hasPacemaker ? \'\342\232\240\357\270\217 PORTADOR (NO RMN)\' : \'Sin Dispositivos\'}\n              </span>\n            </div>\n\n            {/* Metal Implants */}\n            <div className=\"bg-zinc-950/70 border border-zinc-800 p-3 rounded-xl text-zinc-300\">\n              <span className=\"text-[10px] text-zinc-400 block font-medium\">Pr\303\263tesis / Met\303\241licos</span>\n              <span className=\"font-semibold text-xs mt-0.5 block\">\n                {patient.safetyProfile.hasMetalImplants ? \'Material de osteos\303\255ntesis\' : \'Negativo\'}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Diagnostic Imaging Studies History Section */}\n        <div className=\"space-y-3\">\n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"text-base font-bold text-white flex items-center gap-2\">\n              <Activity className=\"w-5 h-5 text-cyan-400\" />\n              <span>Estudios e Im\303\241genes Diagn\303\263sticas ({patientStudies.length})</span>\n            </h3>\n          </div>\n\n          {patientStudies.length === 0 ? (\n            <div className=\"bg-zinc-900/50 border border-zinc-800/80 rounded-2xl p-8 text-center text-zinc-500 space-y-2\">\n              <FileText className=\"w-8 h-8 mx-auto text-zinc-600 opacity-60\" />\n              <p className=\"text-sm\">A\303\272n no hay estudios de imagen registrados para este paciente.</p>\n              <button\n                onClick={() => onOpenNewAppointmentForPatient(patient.id)}\n                className=\"text-xs text-cyan-400 hover:underline\"\n              >\n                Agendar el primer estudio ahora\n              </button>\n            </div>\n          ) : (\n            <div className=\"space-y-3\">\n              {patientStudies.map(st => {\n                const hasReport = Boolean(st.report);\n                const isSigned = st.report?.status === \'FIRMADO_FINAL\';\n\n                return (\n                  <div\n                    key={st.id}\n                    className=\"bg-zinc-900 border border-zinc-800 rounded-xl p-4.5 hover:border-zinc-700 transition-all flex flex-col md:flex-row md:items-center justify-between gap-4\"\n                  >\n                    <div className=\"flex items-start gap-3.5\">\n                      {/* Modality Icon Pill */}\n                      <div className=\"bg-cyan-950 border border-cyan-800/80 text-cyan-300 p-3 rounded-xl text-center shrink-0\">\n                        <span className=\"font-bold text-xs block\">{st.modality}</span>\n                        <span className=\"text-[10px] text-zinc-400 block font-mono mt-0.5\