          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Instrucciones obligatorias de preparaci\303\263n:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
