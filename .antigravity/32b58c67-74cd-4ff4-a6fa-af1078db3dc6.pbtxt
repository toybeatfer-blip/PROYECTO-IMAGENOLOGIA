        }
        lines {
          text: "    keyFindingsSummary: \'Infiltrado alveolar con broncograma a\303\251reo en l\303\263bulo inferior derecho compatible con neumon\303\255a bacteriana adquirida en la comunidad. \303\201ngulos costofr\303\251nicos libres.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    report: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      id: \'rep-003\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      studyId: \'study-003\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      radiologistName: \'Dr. V\303\255ctor Hugo Pe\303\261aloza R.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      radiologistLicense: \'C.M.P. 49201 / R.N.E. 21094\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      reportDate: \'2026-08-14 09:20\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      technique: \'Radiograf\303\255a digital de t\303\263rax en proyecciones p\303\263stero-anterior (PA) y lateral izquierda, con adecuada t\303\251cnica de penetraci\303\263n y sin rotaci\303\263n significativa.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      findings: `1. CAMPOS PULMONARES:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "Se observa un \303\241rea de opacidad radiogr\303\241fica de bordes mal definidos con signos de broncograma a\303\251reo en proyecci\303\263n del l\303\263bulo inferior derecho (segmento basal posterior), compatible con proceso de consolidaci\303\263n alveolar. Resto del par\303\251nquima pulmonar bilateral adecuadamente aireado, sin lesiones cavitadas ni n\303\263dulos sospechosos."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "2. SILUETA CARDIOVASCULAR Y MEDIASTINO:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "\303\215ndice cardiotor\303\241cico dentro de los rangos normales (< 0.50). Mediastino centrado. Bot\303\263n a\303\263rtico e hilios pulmonares de morfolog\303\255a y tama\303\261o habituales."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "3. PLEURA Y ESTRUCTURAS PARIETALES:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "Senos costofr\303\251nicos y cardiofr\303\251nicos agudos y libres bilateralmente, sin derrame pleural visible. Estructuras \303\263seas de la caja tor\303\241cica sin alteraciones l\303\255ticas ni trazos de fractura.`,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      impression: `1. CONSOLIDACI\303\223N ALVEOLAR EN L\303\223BULO INFERIOR DERECHO COMPATIBLE CON NEUMON\303\215A BACTERIANA ADQUIRIDA EN LA COMUNIDAD (NAC)."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "2. SIN SIGNOS RADIOL\303\223GICOS DE DERRAME PLEURAL ASOCIADO.`,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      recommendations: \'Iniciar cobertura antibi\303\263tica seg\303\272n gu\303\255as cl\303\255nicas y control radiol\303\263gico evolutivo a las 4-6 semanas post-tratamiento.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
