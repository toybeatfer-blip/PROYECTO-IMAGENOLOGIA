      replacement_content: "import React from \'react\';\nimport { MedicalStudySeries } from \'../../types\';\nimport { Layers } from \'lucide-react\';\n\ninterface SeriesThumbnailBarProps {\n  series: MedicalStudySeries[];\n  activeSeriesIndex: number;\n  onSelectSeries: (index: number) => void;\n}\n\nexport const SeriesThumbnailBar: React.FC<SeriesThumbnailBarProps> = ({\n  series,\n  activeSeriesIndex,\n  onSelectSeries,\n}) => {\n  return (\n    <div className=\"w-60 bg-zinc-950 border-r border-zinc-800 flex flex-col h-full overflow-hidden select-none\">\n      <div className=\"p-3 border-b border-zinc-800/80 flex items-center justify-between\">\n        <div className=\"flex items-center gap-2 text-xs font-semibold text-zinc-300\">\n          <Layers className=\"w-4 h-4 text-cyan-400\" />\n          <span>Series del Estudio ({series.length})</span>\n        </div>\n      </div>\n\n      <div className=\"flex-1 overflow-y-auto p-2.5 space-y-2.5\">\n        {series.map((item, idx) => {\n          const isSelected = idx === activeSeriesIndex;\n          const firstSliceKey = item.slices[0]?.svgIllustrationKey;\n          return (\n            <div\n              key={item.id}\n              onClick={() => onSelectSeries(idx)}\n              className={`group cursor-pointer rounded-lg border p-2 transition-all ${\n                isSelected\n                  ? \'bg-cyan-950/40 border-cyan-500 shadow-xs shadow-cyan-500/20\'\n                  : \'bg-zinc-900/60 border-zinc-800/80 hover:bg-zinc-900 hover:border-zinc-700\'\n              }`}\n            >\n              {/* Thumbnail Container */}\n              <div className=\"w-full h-24 bg-black rounded-md overflow-hidden flex items-center justify-center border border-zinc-800 relative mb-2\">\n                <div className=\"w-20 h-20 opacity-80 group-hover:opacity-100 transition-opacity\">\n                  <svg viewBox=\"0 0 512 512\" className=\"w-full h-full\">\n                    <rect width=\"512\" height=\"512\" fill=\"#09090b\" />\n                    <circle cx=\"256\" cy=\"256\" r=\"160\" fill=\"#27272a\" stroke=\"#71717a\" strokeWidth=\"6\" />\n                    <ellipse cx=\"256\" cy=\"256\" rx=\"90\" ry=\"110\" fill=\"#3f3f46\" />\n                  </svg>\n                </div>\n                <div className=\"absolute top-1 left-1.5 text-[10px] font-mono bg-black/70 px-1.5 py-0.5 rounded text-cyan-300\">\n                  {item.plane}\n                </div>\n                <div className=\"absolute bottom-1 right-1.5 text-[10px] font-mono bg-black/70 px-1.5 py-0.5 rounded text-zinc-300\">\n                  {item.slices.length} cortes\n                </div>\n              </div>\n\n              {/* Series Info */}\n              <div className=\"text-xs font-medium text-zinc-200 line-clamp-1 group-hover:text-cyan-300 transition-colors\">\n                {item.seriesNumber}. {item.name}\n              </div>\n              <div className=\"text-[11px] text-zinc-500 line-clamp-1 mt-0.5\">{item.description}</div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
