    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { MedicalStudy } from \'../../types\';\nimport { Printer, X, ShieldCheck, QrCode, Download } from \'lucide-react\';\n\ninterface PrintableReportViewProps {\n  study: MedicalStudy;\n  onClose: () => void;\n}\n\nexport const PrintableReportView: React.FC<PrintableReportViewProps> = ({ study, onClose }) => {\n  const report = study.report;\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-xs select-none overflow-y-auto\">\n      <div className=\"bg-white text-zinc-900 rounded-2xl w-full max-w-4xl shadow-2xl overflow-hidden flex flex-col my-auto border border-zinc-200 print:border-none print:shadow-none print:m-0 print:p-0\">\n        {/* Modal Toolbar (hidden when printing) */}\n        <div className=\"p-4 bg-zinc-900 text-white flex items-center justify-between print:hidden\">\n          <div className=\"flex items-center gap-2\">\n            <ShieldCheck className=\"w-5 h-5 text-emerald-400\" />\n            <span className=\"font-semibold text-sm\">Vista Oficial de Impresi\303\263n / Documento PDF</span>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={handlePrint}\n              className=\"flex items-center gap-1.5 px-4 py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg text-xs font-semibold shadow-sm transition-all\"\n            >\n              <Printer className=\"w-4 h-4\" />\n              <span>Imprimir / Guardar como PDF</span>\n            </button>\n            <button\n              onClick={onClose}\n              className=\"p-2 text-zinc-400 hover:text-white hover:bg-zinc-800 rounded-lg transition-colors\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Printable Document Sheet */}\n        <div className=\"p-8 sm:p-12 space-y-6 bg-white font-sans text-zinc-900 text-sm leading-relaxed\" id=\"printable-area\">\n          {/* Header */}\n          <div className=\"border-b-2 border-zinc-900 pb-4 flex justify-between items-start\">\n            <div>\n              <h1 className=\"text-xl font-bold tracking-tight text-zinc-900\">\n                CENTRO ESPECIALIZADO DE DIAGN\303\223STICO POR IM\303\201GENES\n              </h1>\n              <p className=\"text-xs text-zinc-600 font-medium mt-0.5\">\n                Departamento de Radiolog\303\255a, Tomograf\303\255a Computarizada y Resonancia Magn\303\251tica\n              </p>\n              <p className=\"text-[11px] text-zinc-500\">\n                Av. Javier Prado Este 2840 | Central: (01) 614-2200 | informes@imagenmedica.com\n              </p>\n            </div>\n            <div className=\"text-right\">\n              <span className=\"inline-block px-3 py-1 bg-zinc-100 text-zinc-800 border border-zinc-300 rounded font-mono text-xs font-bold\">\n                ACC: {study.accessionNumber}\n              </span>\n              <p className=\"text-[11px] text-zinc-500 mt-1\">Fecha: {study.studyDate} | {study.studyTime}</p>\n            </div>\n          </div>\n\n          {/* Patient Demographic Table */}\n          <div className=\"bg-zinc-50 border border-zinc-300 rounded-lg p-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs\">\n            <div>\n              <span className=\"text-zinc-500 block\">Paciente:</span>\n              <span className=\"font-bold text-zinc-900 text-sm\">{study.patientName}</span>\n            </div>\n            <div>\n              <span className=\"text-zinc-500 block\">DNI / C\303\251dula:</span>\n              <span className=\"font-semibold text-zinc-900\">{study.patientDni}</span>\n            </div>\n            <div>\n              <span className=\"text-zinc-500 block\">Edad / G\303\251nero:</span>\n              <span className=\"font-semibold text-zinc-900\">\n                {study.patientAge} a\303\261os / {study.patientGender === \'M\' ? \'Masculino\' : \'Femenino\'}\n              </span>\n            </div>\n            <div>\n              <span className=\"text-zinc-500 block\">M\303\251dico Solicitante:</span>\n              <span className=\"font-semibold text-zinc-900\">{study.referringDoctor}</span>\n            </div>\n            <div className=\"col-span-2\">\n              <span className=\"text-zinc-500 block\">Estudio Solicitado:</span>\n              <span className=\"font-bold text-cyan-900 text-sm\">{study.studyName}</span>\n            </div>\n            <div className=\"col-span-2\">\n              <span className=\"text-zinc-500 block\">Indicaci\303\263n Cl\303\255nica / Diagn\303\263stico Presuntivo:</span>\n              <span className=\"font-medium text-zinc-800\">{study.clinicalIndication}</span>\n            </div>\n          </div>\n\n          {/* Technique Section */}\n          <div>\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-zinc-900 border-b border-zinc-200 pb-1 mb-2\">\n              T\303\211CNICA DE ADQUISICI\303\223N Y PROTOCOLO:\n            </h3>\n            <p className=\"text-xs text-zinc-700 text-justify\">\n              {report?.technique ||\n                `Estudio realizado con equipo ${study.equipmentModel}, obteni\303\251ndose secuencias multiplanares de alta definici\303\263n.`}\n            </p>\n          </div>\n\n          {/* Findings Section */}\n          <div>\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-zinc-900 border-b border-zinc-200 pb-1 mb-2\">\n              HALLAZGOS:\n            </h3>\n            <div className=\"text-xs text-zinc-800 whitespace-pre-line leading-relaxed text-justify font-mono\">\n              {report?.findings || \'Sin hallazgos patol\303\263gicos descritos.\'}\n            </div>\n          </div>\n\n          {/* Impression / Conclusion Section */}\n          <div className=\"bg-zinc-50 border-l-4 border-cyan-700 p-4 rounded-r-lg\">\n            <h3 className=\"text-xs font-bold uppercase tracking-wider text-cyan-900 mb-1\">\n              CONCLUSI\303\223N / IMPRESI\303\223N DIAGN\303\223STICA:\n            </h3>\n            <div className=\"text-xs font-bold text-zinc-900 whitespace-pre-line leading-relaxed\">\n              {report?.impression || \'Estudio concluido sin incidentes.\'}\n            </div>\n            {report?.biRadsOrScore && (\n              <div className=\"mt-2 text-xs font-semibold text-emerald-800\">\n                CLASIFICACI\303\223N: {report.biRadsOrScore}\n              </div>\n            )}\n          </div>\n\n          {/* Recommendations */}\n          {report?.recommendations && (\n            <div>\n              <h3 className=\"text-xs font-bold uppercase tracking-wider text-zinc-900 border-b border-zinc-200 pb-1 mb-1\">\n                RECOMENDACIONES:\n              </h3>\n              <p className=\"text-xs text-zinc-700\">{report.recommendations}</p>\n            </div>\n          )}\n\n          {/* Signatures & QR Digital Verification Stamp */}\n          <div className=\"pt-6 border-t border-zinc-300 grid grid-cols-1 sm:grid-cols-2 gap-6 items-end\">\n            <div className=\"flex items-center gap-3 bg-zinc-50 border border-zinc-200 p-3 rounded-lg\">\n              <div className=\"p-2 bg-white border border-zinc-300 rounded text-zinc-800\">\n                <QrCode className=\"w-10 h-10\" />\n              </div>\n              <div className=\"text-[11px] text-zinc-600\">\n                <p className=\"font-bold text-zinc-900\">FIRMA DIGITAL VERIFICADA</p>\n                <p className=\"font-mono text-[10px] text-zinc-500\">Hash: {report?.signatureHash || \'SECURE-SHA256-VALID\'}</p>\n                <p>Fecha de emisi\303\263n: {report?.signedAt || study.studyDate}</p>\n              </div>\n            </div>\n\n            <div className=\"text-center sm:text-right border-t sm:border-t-0 pt-3 sm:pt-0\">\n              <div className=\"inline-block text-center min-w-[220px]\">\n                <div className=\"font-serif italic text-cyan-900 text-lg font-bold border-b border-zinc-400 pb-1 mb-1\">\n                  {report?.radiologistName || \'Dr. V\303\255ctor Hugo Pe\303\261aloza R.\'}\n                </div>\n                <p className=\"text-xs font-bold text-zinc-900\">\n                  {report?.radiologistName || \'Dr. V\303\255ctor Hugo Pe\303\261aloza R.\'}\n                </p>\n                <p className=\"text-[11px] text-zinc-600\">\n                  {report?.radiologistLicense || \'C.M.P. 49201 / R.N.E. 21094\'}\n                </p>\n                <p className=\"text-[10px] text-zinc-500 uppercase\">M\303\251dico Especialista en Radiolog\303\255a</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
