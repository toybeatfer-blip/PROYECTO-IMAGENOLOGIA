        lines {
          text: "        </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      {/* HUD: Bottom Left - Viewport Geometry & Window/Level */}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      <div className=\"absolute bottom-4 left-4 z-20 pointer-events-none text-xs font-mono space-y-0.5 text-cyan-400/90 drop-shadow-[0_1px_2px_rgba(0,0,0,0.9)] bg-black/40 backdrop-blur-xs p-2 rounded border border-white/5\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <div className=\"text-white font-medium\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          CORTE: {sliceIndex + 1} / {totalSlices} ({currentSlice.sliceLocation})"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <div className=\"text-neutral-300\">Grosor: {currentSlice.sliceThickness} | Matriz: {activeSeries.matrixSize}</div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <div className=\"text-neutral-400\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          Zoom: {Math.round(zoom * 100)}% | W: {Math.round(contrast * 4)} L: {Math.round((brightness - 100) * 2 + 40)}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      {/* HUD: Bottom Right - Cursor Coordinate & HU Density */}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      <div className=\"absolute bottom-4 right-4 z-20 pointer-events-none text-xs font-mono text-right space-y-0.5 text-cyan-400/90 drop-shadow-[0_1px_2px_rgba(0,0,0,0.9)] bg-black/40 backdrop-blur-xs p-2 rounded border border-white/5\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
